rop&w=1920&q=80",\n  },\n  {\n    key: "metal-parts",\n    label: "Metal Parts",\n    subtitle: "Cinematic gears and machined surfaces.",\n    ctaPrimary: "Watch",\n    ctaSecondary: "See details",\n    palette: {\n      base: "bg-zinc-950",\n      text: "text-zinc-100",\n      accent: "text-cyan-400",\n      overlay: "bg-zinc-900/60",\n    },\n    video:\n      "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",\n    poster:\n      "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1920&q=80",\n  },\n];\n\nexport function getTheme(key: string): Theme | undefined {\n  return themes.find((t) => t.key === key);\n}\n'}

🔧  write_file {'path': 'src/app/[theme]/page.tsx', 'content': '"use client";\n\nimport { useParams } from "next/navigation";\nimport { useEffect, useState } from "react";\nimport VideoHero from "@/components/VideoHero";\nimport { themes, type Theme } from "@/lib/themes";\n\nconst ALLOWED = new Set(themes.map((t) => t.key));\n\nexport default function ThemePage() {\n  const { theme } = useParams<{ theme: string }>();\n  const [resolved, setResolved] = useState<Theme | null>(null);\n\n  useEffect(() => {\n    if (!theme || !ALLOWED.has(theme)) {\n      setResolved(null);\n      return;\n    }\n    setResolved(themes.find((t) => t.key === theme) ?? null);\n  }, [theme]);\n\n  if (!resolved) {\n    return (\n      <div className="min-h-screen bg-stone-950 flex items-center justify-center text-stone-400">\n        <p>Theme not found.</p>\n      </div>\n    );\n  }\n\n  return <VideoHero themeKey={resolved.key} />;\n}\n'}
