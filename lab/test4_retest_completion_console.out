🔧  write_file {'content': '"use client";\n\nimport { useState, useEffect } from "react";\nimport { themes, type Theme } from "@/lib/themes";\n\nexport default function VideoHero({ themeKey }: { themeKey: string }) {\n  const theme = themes.find((t) => t.key === themeKey);\n  const [t, setT] = useState<Theme | null>(null);\n  const [loaded, setLoaded] = useState(false);\n  const [prefersReduced, setPrefersReduced] = useState(false);\n  const [error, setError] = useState(false);\n\n  useEffect(() => {\n    const m = window.matchMedia("(prefers-reduced-motion: reduce)");\n    setPrefersReduced(m.matches);\n    const handler = (e: MediaQueryListEvent) => setPrefersReduced(e.matches);\n    m.addEventListener("change", handler);\n    return () => m.removeEventListener("change", handler);\n  }, []);\n\n  useEffect(() => {\n    if (!theme) {\n      setT(null);\n      setLoaded(true);\n      setError(true);\n      return;\n    }\n    setT(theme);\n    if (prefersReduced) {\n      setLoaded(true);\n      return;\n    }\n    const img = new Image();\n    img.src = theme.video;\n    img.onload = () => {\n      setLoaded(true);\n    };\n    img.onerror = () => {\n      setLoaded(true);\n      setError(true);\n    };\n  }, [theme, prefersReduced]);\n\n  if (!t) {\n    return (\n      <div className="min-h-screen bg-stone-950 flex items-center justify-center text-stone-400">\n        <p>Theme not found.</p>\n      </div>\n    );\n  }\n\n  return (\n    <div\n      className={`relative min-h-screen w-full overflow-hidden ${t.palette.base} flex flex-col`}\n      style={{ backgroundAttachment: "fixed" }}\n    >\n      <div className={`absolute inset-0 ${t.palette.overlay}`} />\n\n      {!loaded && (\n        <div className="absolute inset-0 flex items-center justify-center">\n          <div className="flex flex-col items-center gap-4">\n            <div\n              className="w-16 h-16 rounded-full border-2 border-current/20 animate-pulse"\n              style={{\n                borderColor: t.palette.accent,\n                background: `url(${t.poster}) center/cover`,\n                backgroundSize: "cover",\n              }}\n            />\n            <span\n              className={`text-sm tracking-widest uppercase ${t.palette.text}`}\n              aria-label="Loading video"\n            >\n              Loading\n            </span>\n          </div>\n        </div>\n      )}\n\n      {error && (\n        <div className="absolute inset-0 flex items-center justify-center">\n          <p className={t.palette.text}>Unable to load video.</p>\n        </div>\n      )}\n\n      <video\n        key={t.key}\n        autoPlay\n        muted\n        loop\n        playsInline\n        preload="metadata"\n        poster={t.poster}\n        className="absolute inset-0 w-full h-full object-cover"\n        aria-label={`${t.label} showcase video`}\n        style={{\n          opacity: loaded ? 1 : 0,\n          transition: "opacity 0.6s ease",\n        }}\n      >\n        <source src={t.video} type="video/mp4" />\n      </video>\n\n      <div className="relative z-10 flex flex-col items-start justify-end p-6 md:p-10 lg:p-16">\n        <span className={`text-xs tracking-[0.2em] uppercase ${t.palette.accent}`}>\n          {t.label}\n        </span>\n        <h1 className={`mt-2 text-3xl md:text-5xl lg:text-6xl font-light tracking-tight ${t.palette.text}`}>\n          {t.label === "Metal Parts"\n            ? "Machined Motion"\n            : t.label === "Still Life"\n            ? "Quiet Objects"\n            : t.label === "Materials"\n            ? "Tactile Surfaces"\n            : "Living Landscapes"}\n        </h1>\n        <p className={`mt-3 max-w-xl text-base md:text-lg ${t.palette.text}/80`}>\n          {t.subtitle}\n        </p>\n\n        <div className="mt-6 flex flex-wrap gap-3">\n          <button\n            className={`px-5 py-2.5 rounded-sm text-sm tracking-wide border transition-colors ${\n              t.palette.accent\n            } ${t.palette.text}`}\n          >\n            {t.ctaPrimary}\n          </button>\n          <button\n            className={`px-5 py-2.5 rounded-sm text-sm tracking-wide border border-current/20 ${\n              t.palette.text\n            }/70 hover:bg-current/5`}\n          >\n            {t.ctaSecondary}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n', 'path': 'src/components/VideoHero.tsx'}

🔧  write_file {'content': 'import Link from "next/link";\nimport { themes } from "@/lib/themes";\n\nexport default function IndexPage() {\n  return (\n    <div className="min-h-screen bg-stone-950">\n      <header className="border-b border-stone-800">\n        <div className="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">\n          <Link href="/" className="text-stone-100 tracking-tight">\n            Pulse\n          </Link>\n          <nav className="flex items-center gap-6 text-sm tracking-wide text-stone-400">\n            {themes.map((t) => (\n              <Link\n                key={t.key}\n                href={`/${t.key}`}\n                className="hover:text-stone-100 transition-colors"\n              >\n                {t.label}\n              </Link>\n            ))}\n          </nav>\n        </div>\n      </header>\n\n      <main className="mx-auto max-w-7xl px-6 py-20">\n        <div className="mb-12 text-center">\n          <h1 className="text-4xl md:text-6xl font-light tracking-tight text-stone-100">\n            Video Hero\n          </h1>\n          <p className="mt-4 max-w-xl mx-auto text-stone-400">\n            Four curated routes. Each with its own palette, texture, and motion.\n          </p>\n        </div>\n\n        <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">\n          {themes.map((t) => (\n            <Link\n              key={t.key}\n              href={`/${t.key}`}\n              className="group block rounded-sm border border-stone-800 bg-stone-900/40 p-6 hover:border-stone-700 hover:bg-stone-900/60 transition-all"\n            >\n              <div\n                className="mb-4 aspect-video rounded-sm overflow-hidden"\n                style={{\n                  backgroundImage: `url(${t.poster})`,\n                  backgroundSize: "cover",\n                  backgroundPosition: "center",\n                }}\n              >\n                <div className="absolute inset-0 bg-stone-900/30" />\n              </div>\n              <span className="mb-2 block text-xs tracking-[0.2em] uppercase text-emerald-400">\n                {t.label}\n              </span>\n              <h3 className="text-lg font-light text-stone-100">\n                {t.label === "Metal Parts"\n                  ? "Machined Motion"\n                  : t.label === "Still Life"\n                  ? "Quiet Objects"\n                  : t.label === "Materials"\n                  ? "Tactile Surfaces"\n                  : "Living Landscapes"}\n              </h3>\n              <p className="mt-1 text-sm text-stone-400">{t.subtitle}</p>\n            </Link>\n          ))}\n        </div>\n      </main>\n\n      <footer className="border-t border-stone-800">\n        <div className="mx-auto flex max-w-7xl items-center justify-between px-6 py-6">\n          <span className="text-xs text-stone-500">© {new Date'}
