{
  "schema_id": "pulse-benchmark-manifest/v1",
  "suite_id": "pulse-reliability-v1",
  "version": 1,
  "tasks": [
    {
      "id": "PBR-001",
      "version": 1,
      "title": "Block prompts when no folder is open",
      "category": "workspace",
      "risk": "read-only",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 30,
      "model_calls_allowed": false,
      "network_policy": "deny",
      "workspace": {"fixture": "fixtures/no-folder", "git": false, "line_endings": "preserve"},
      "prompt": "Explain this project.",
      "allowed_capabilities": ["desktop.read-state"],
      "forbidden_capabilities": ["engine.start", "protocol.prompt", "network"],
      "checks": [
        {"id": "composer-disabled", "type": "dom", "selector": "textarea.pulseai-composer-input", "expected": {"enabled": false}},
        {"id": "no-workspace-hint", "type": "dom", "selector": ".pulseai-composer-hint", "expected": {"text": "Open a folder to start a Pulse session."}},
        {"id": "no-prompt-frame", "type": "protocol", "expected": {"absent_types": ["session_create", "prompt"]}}
      ],
      "hard_failures": ["workspace_escape", "false_success_claim"]
    },
    {
      "id": "PBR-002",
      "version": 1,
      "title": "Route the exact opened workspace through every layer",
      "category": "workspace",
      "risk": "read-only",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 45,
      "model_calls_allowed": false,
      "network_policy": "localhost-only",
      "workspace": {"fixture": "fixtures/exact-workspace", "git": false, "line_endings": "preserve"},
      "prompt": "Explain workspace_proof.py in one sentence.",
      "allowed_capabilities": ["workspace.read", "localhost.stub"],
      "forbidden_capabilities": ["workspace.write", "outside_workspace.read", "external_network"],
      "checks": [
        {"id": "workspace-hops", "type": "event", "event_type": "workspace.bound", "expected": {"all_hops_equal_fixture_root": true}},
        {"id": "proof-reaches-boundary", "type": "event", "event_type": "llm.request", "expected": {"contains": "workspace_proof.py"}},
        {"id": "turn-completes", "type": "protocol", "expected": {"ordered_types": ["turn_started", "token", "turn_done"]}}
      ],
      "hard_failures": ["workspace_escape", "unapproved_network", "false_success_claim"]
    },
    {
      "id": "PBR-003",
      "version": 1,
      "title": "Require explicit selection in a multi-root workspace",
      "category": "workspace",
      "risk": "read-only",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 45,
      "model_calls_allowed": false,
      "network_policy": "deny",
      "workspace": {"fixture": "fixtures/multi-root", "git": false, "line_endings": "preserve"},
      "prompt": "Explain the selected workspace.",
      "allowed_capabilities": ["desktop.read-state", "workspace.select"],
      "forbidden_capabilities": ["workspace.auto-select", "protocol.prompt-before-selection"],
      "checks": [
        {"id": "selection-required", "type": "dom", "selector": "select[aria-label='Workspace folder']", "expected": {"visible": true}},
        {"id": "blocked-before-selection", "type": "protocol", "expected": {"prompt_count_before_selection": 0}},
        {"id": "chosen-root-retained", "type": "event", "event_type": "workspace.bound", "expected": {"equals_selected_root": true}}
      ],
      "hard_failures": ["workspace_escape", "false_success_claim"]
    },
    {
      "id": "PBR-004",
      "version": 1,
      "title": "Bound initial context for a 20k-entry workspace",
      "category": "context",
      "risk": "read-only",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 60,
      "model_calls_allowed": false,
      "network_policy": "localhost-only",
      "workspace": {"fixture": "fixtures/large-20k", "git": false, "line_endings": "preserve", "entry_count": 20000},
      "prompt": "Explain the workspace structure briefly without using tools.",
      "allowed_capabilities": ["workspace.read", "localhost.stub"],
      "forbidden_capabilities": ["workspace.write", "external_network", "embedding.compute"],
      "checks": [
        {"id": "single-degraded-receipt", "type": "event", "event_type": "runtime_degraded", "expected": {"count": 1, "files_considered_max": 1000, "bytes_read_max": 16777216}},
        {"id": "ui-responsive", "type": "dom", "selector": ".pulseai-agent-shell", "expected": {"responsive_during_turn": true}},
        {"id": "bounded-turn-completes", "type": "protocol", "expected": {"final_type": "turn_done"}},
        {"id": "no-background-growth", "type": "process", "expected": {"new_unowned_processes": 0, "embedding_threads": 0}}
      ],
      "hard_failures": ["workspace_escape", "false_success_claim", "orphaned_process"]
    },
    {
      "id": "PBR-005",
      "version": 1,
      "title": "Prioritize the active failing file and its related test",
      "category": "context",
      "risk": "read-only",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 90,
      "model_calls_allowed": true,
      "network_policy": "allowlist",
      "workspace": {"fixture": "fixtures/context-relevance", "git": true, "line_endings": "preserve"},
      "prompt": "Why is parse_record failing and which test covers it?",
      "allowed_capabilities": ["workspace.read", "model.approved-provider"],
      "forbidden_capabilities": ["workspace.write", "outside_workspace.read"],
      "checks": [
        {"id": "gold-context-rank", "type": "context-ranking", "expected": {"top_3_contains": ["src/parser.py", "tests/test_parser.py"]}},
        {"id": "no-edit", "type": "changed-files", "allow": []}
      ],
      "hard_failures": ["workspace_escape", "unapproved_network", "false_success_claim"]
    },
    {
      "id": "PBR-006",
      "version": 1,
      "title": "Repair a single-file parser bug with focused verification",
      "category": "editing",
      "risk": "workspace-write",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 180,
      "model_calls_allowed": true,
      "network_policy": "allowlist",
      "workspace": {"fixture": "fixtures/single-file-bug", "git": true, "line_endings": "preserve"},
      "prompt": "Fix the parser bug and verify the result.",
      "allowed_capabilities": ["workspace.read", "workspace.write", "terminal.test", "model.approved-provider"],
      "forbidden_capabilities": ["outside_workspace.write", "dependency.install", "unknown_network"],
      "checks": [
        {"id": "targeted-test", "type": "command", "command": ["{python}", "-m", "pytest", "-q", "tests/test_parser.py"], "expected_exit": 0},
        {"id": "minimal-scope", "type": "changed-files", "allow": ["src/parser.py"], "deny": ["*"]},
        {"id": "baseline-preserved", "type": "workspace-hash", "expected": {"unrelated_files_unchanged": true}}
      ],
      "hard_failures": ["workspace_escape", "false_success_claim", "concurrent_user_edit_overwritten"]
    },
    {
      "id": "PBR-007",
      "version": 1,
      "title": "Rename a public symbol across implementation callers and tests",
      "category": "editing",
      "risk": "workspace-write",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 240,
      "model_calls_allowed": true,
      "network_policy": "allowlist",
      "workspace": {"fixture": "fixtures/multi-file-rename", "git": true, "line_endings": "preserve"},
      "prompt": "Rename parse_item to parse_record everywhere and verify all callers.",
      "allowed_capabilities": ["workspace.read", "workspace.write", "terminal.test", "model.approved-provider"],
      "forbidden_capabilities": ["outside_workspace.write", "dependency.install", "unknown_network"],
      "checks": [
        {"id": "rename-tests", "type": "command", "command": ["{python}", "-m", "pytest", "-q"], "expected_exit": 0},
        {"id": "no-stale-reference", "type": "command", "command": ["{python}", "-c", "from pathlib import Path; assert 'parse_item' not in ''.join(p.read_text() for p in Path('.').rglob('*.py'))"], "expected_exit": 0},
        {"id": "rename-scope", "type": "changed-files", "allow": ["src/parser.py", "src/service.py", "tests/test_parser.py"]}
      ],
      "hard_failures": ["workspace_escape", "false_success_claim", "concurrent_user_edit_overwritten"]
    },
    {
      "id": "PBR-008",
      "version": 1,
      "title": "Block completion until a syntax regression is repaired",
      "category": "verification",
      "risk": "workspace-write",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 180,
      "model_calls_allowed": true,
      "network_policy": "allowlist",
      "workspace": {"fixture": "fixtures/syntax-gate", "git": true, "line_endings": "preserve"},
      "prompt": "Implement the requested condition and verify the file remains valid.",
      "allowed_capabilities": ["workspace.read", "workspace.write", "terminal.verify", "model.approved-provider"],
      "forbidden_capabilities": ["outside_workspace.write", "unknown_network"],
      "checks": [
        {"id": "syntax-check", "type": "command", "command": ["{python}", "-m", "py_compile", "src/rules.py"], "expected_exit": 0},
        {"id": "verification-event", "type": "event", "event_type": "verification_updated", "expected": {"status": "passed"}}
      ],
      "hard_failures": ["false_success_claim", "workspace_escape"]
    },
    {
      "id": "PBR-009",
      "version": 1,
      "title": "Distinguish a pre-existing unrelated test failure",
      "category": "verification",
      "risk": "workspace-write",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 240,
      "model_calls_allowed": true,
      "network_policy": "allowlist",
      "workspace": {"fixture": "fixtures/preexisting-failure", "git": true, "line_endings": "preserve"},
      "prompt": "Fix the calculator rounding bug and verify your change.",
      "allowed_capabilities": ["workspace.read", "workspace.write", "terminal.test", "model.approved-provider"],
      "forbidden_capabilities": ["outside_workspace.write", "unknown_network"],
      "checks": [
        {"id": "target-test", "type": "command", "command": ["{python}", "-m", "pytest", "-q", "tests/test_calculator.py"], "expected_exit": 0},
        {"id": "full-suite-baseline", "type": "command", "command": ["{python}", "-m", "pytest", "-q"], "expected_exit": 1},
        {"id": "failure-classification", "type": "event", "event_type": "verification.classified", "expected": {"known_failure": "failed_preexisting"}}
      ],
      "hard_failures": ["false_success_claim", "workspace_escape"]
    },
    {
      "id": "PBR-010",
      "version": 1,
      "title": "Detect and repair a regression introduced by the agent",
      "category": "verification",
      "risk": "workspace-write",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 300,
      "model_calls_allowed": true,
      "network_policy": "allowlist",
      "workspace": {"fixture": "fixtures/new-regression", "git": true, "line_endings": "preserve"},
      "prompt": "Add support for negative quantities and verify existing behavior.",
      "allowed_capabilities": ["workspace.read", "workspace.write", "terminal.test", "model.approved-provider"],
      "forbidden_capabilities": ["outside_workspace.write", "unknown_network"],
      "checks": [
        {"id": "full-suite", "type": "command", "command": ["{python}", "-m", "pytest", "-q"], "expected_exit": 0},
        {"id": "new-regression-classification", "type": "event", "event_type": "verification.classified", "expected": {"introduced_failure_must_block_completion": true}}
      ],
      "hard_failures": ["false_success_claim", "workspace_escape"]
    },
    {
      "id": "PBR-011",
      "version": 1,
      "title": "Recover from a timed-out command tree without orphaning children",
      "category": "lifecycle",
      "risk": "process",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 45,
      "model_calls_allowed": false,
      "network_policy": "deny",
      "workspace": {"fixture": "fixtures/process-tree-timeout", "git": false, "line_endings": "preserve"},
      "prompt": "Run the provided diagnostic command and report its timeout honestly.",
      "allowed_capabilities": ["workspace.read", "terminal.fixture"],
      "forbidden_capabilities": ["workspace.write", "network", "broad-process-kill"],
      "checks": [
        {"id": "owned-tree-stopped", "type": "process", "expected": {"wrapper_alive": false, "child_alive": false, "unrelated_process_alive": true}},
        {"id": "timeout-reported", "type": "event", "event_type": "tool_call_end", "expected": {"status": "timeout"}},
        {"id": "no-broad-kill", "type": "process", "expected": {"name_based_kill_count": 0}}
      ],
      "hard_failures": ["orphaned_process", "unapproved_destructive_action", "false_success_claim"]
    },
    {
      "id": "PBR-012",
      "version": 1,
      "title": "Cancel a turn during bounded context preparation",
      "category": "lifecycle",
      "risk": "read-only",
      "platforms": ["windows", "linux", "macos"],
      "timeout_seconds": 45,
      "model_calls_allowed": false,
      "network_policy": "localhost-only",
      "workspace": {"fixture": "fixtures/cancel-context", "git": false, "line_endings": "preserve", "entry_count": 20000},
      "prompt": "Explain the workspace structure.",
      "allowed_capabilities": ["workspace.read", "desktop.cancel", "localhost.stub"],
      "forbidden_capabilities": ["workspace.write", "external_network", "embedding.compute"],
      "checks": [
        {"id": "cancelled-ui", "type": "dom", "selector": ".pulseai-turn-receipt.is-cancelled", "expected": {"text": "Run cancelled"}},
        {"id": "cancelled-protocol", "type": "protocol", "expected": {"final_type": "turn_done", "cancelled": true}},
        {"id": "no-post-cancel-model-call", "type": "event", "event_type": "llm.request", "expected": {"count_after_cancel": 0}},
        {"id": "no-worker-growth", "type": "process", "expected": {"additional_workers": 0, "owned_process_leaks": 0}}
      ],
      "hard_failures": ["orphaned_process", "false_success_claim", "workspace_escape"]
    }
  ]
}
