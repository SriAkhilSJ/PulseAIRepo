 background: var(--brand); color: #fff; border: none;\n  padding: 10px 16px; border-radius: 8px; font-weight: 600;\n  display: flex; align-items: center; gap: 8px;\n}\n.cart-btn:hover { background: var(--brand-dark); }\n.badge {\n  background: var(--amber); color: #131a26;\n  border-radius: 999px; font-size: 12px; font-weight: 700;\n  min-width: 20px; padding: 1px 6px; text-align: center;\n}\n\n/* ---------- buttons ---------- */\n.btn {\n  border: 1px solid var(--line); background: #fff; color: var(--ink);\n  padding: 10px 16px; border-radius: 8px; font-weight: 600;\n}\n.btn:hover { background: #f7f8fa; }\n.btn.primary { background: var(--brand); border-color: var(--brand); color: #fff; }\n.btn.primary:hover { background: var(--brand-dark); }\n.btn.ghost { background: transparent; }\n.btn.lg { padding: 13px 26px; font-size: 16px; }\n.btn.block { width: 100%; }\n.btn:disabled { opacity: .55; cursor: not-allowed; }\n\n/* ---------- hero ---------- */\n.hero {\n  display: flex; align-items: center; justify-content: space-between; gap: 24px;\n  background: linear-gradient(120deg, #0f6fff 0%, #0a3d99 100%);\n  color: #fff; border-radius: var(--radius);\n  padding: 40px 36px; margin: 26px 0;\n}\n.hero h1 { margin: 0 0 10px; font-size: 34px; letter-spacing: -.02em; }\n.hero p { margin: 0 0 20px; opacity: .9; max-width: 520px; }\n.hero .btn.primary { background: var(--amber); border-color: var(--amber); color: #131a26; }\n.hero-badge {\n  background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.25);\n  padding: 12px 18px; border-radius: 999px; font-weight: 600; white-space: nowrap;\n}\n\n/* ---------- toolbar ---------- */\n.toolbar {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 16px; flex-wrap: wrap; margin-bottom: 20px;\n}\n.chips { display: flex; gap: 8px; flex-wrap: wrap; }\n.chip {\n  border: 1px solid var(--line); background: #fff; border-radius: 999px;\n  padding: 7px 15px; font-weight: 600; font-size: 14px; color: var(--muted);\n}\n.chip:hover { border-color: var(--brand); color: var(--brand); }\n.chip.active { background: var(--ink); border-color: var(--ink); color: #fff; }\n.toolbar-right { display: flex; align-items: center; gap: 16px; }\n.stock-toggle { font-size: 14px; color: var(--muted); display: flex; align-items: center; gap: 6px; }\n#sort { padding: 9px 12px; border-radius: 8px; border: 1px solid var(--line); background: #fff; }\n\n/* ---------- product grid ---------- */\n.grid {\n  display: grid; gap: 20px; padding-bottom: 60px;\n  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));\n}\n.card {\n  background: var(--surface); border: 1px solid var(--line);\n  border-radius: var(--radius); box-shadow: var(--shadow);\n}\n.product {\n  background: var(--surface); border: 1px solid var(--line);\n  border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column;\n  transition: transform .15s ease, box-shadow .15s ease;\n}\n.product:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }\n.product-img {\n  position: relative; aspect-ratio: 4 / 3; background: #eef1f5; cursor: pointer;\n}\n.product-img img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.tag {\n  position: absolute; top: 10px; left: 10px;\n  background: var(--red); color: #fff; font-size: 12px; font-weight: 700;\n  padding: 3px 9px; border-radius: 999px;\n}\n.product-body { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }\n.product-brand { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }\n.product-title {\n  font-size: 15px; font-weight: 600; line-height: 1.35; margin: 0; cursor: pointer;\n  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;\n}\n.product-title:hover { color: var(--brand); }\n.rating { font-size: 13px; color: var(--amber); }\n.rating span { color: var(--muted); margin-left: 4px; }\n.price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; }\n.price { font-size: 20px; font-weight: 700; }\n.list-price { color: var(--muted); text-decoration: line-through; font-size: 14px; }\n.stock { font-size: 13px; color: var(--green); font-weight: 600; }\n.stock.out { color: var(--red); }\n.product .btn { margin: 0 14px 14px; }\n.empty { text-align: center; color: var(--muted); padding: 60px 0; font-size: 17px; }\n\n/* ---------- cart drawer ---------- */\n.overlay {\n  position: fixed; inset: 0; background: rgba(16, 24, 40, .5);\n  z-index: 60; display: flex; justify-content: flex-end;\n}\n.overlay.center { align-items: center; justify-content: center; }\n.drawer {\n  background: #fff; width: min(440px, 100%); height: 100%;\n  display: flex; flex-direction: column; box-shadow: var(--shadow-lg);\n}\n.drawer-head {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 18px 20px; border-bottom: 1px solid var(--line);\n}\n.drawer-head h2 { margin: 0; font-size: 19px; }\n.cart-items { flex: 1; overflow-y: auto; padding: 14px 20px; }\n.cart-item { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }\n.cart-item img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; }\n.cart-item-info { flex: 1; }\n.cart-item-info h4 { margin: 0 0 4px; font-size: 14px; font-weight: 600; }\n.cart-item-info .price { font-size: 15px; }\n.qty { display: flex; align-items: center; gap: 8px; margin-top: 6px; }\n.qty button {\n  width: 26px; height: 26px; border-radius: 6px; border: 1px solid var(--line);\n  background: #fff; font-weight: 700;\n}\n.qty button:hover { background: #f3f4f7; }\n.cart-summary {\n  padding: 16px 20px; border-top: 1px solid var(--line);\n  font-size: 14px; display: flex; flex-direction: column; gap: 6px;\n}\n.cart-summary .line { display: flex; justify-content: space-between; }\n.cart-summary .grand { font-weight: 700; font-size: 17px; }\n.checkout { padding: 16px 20px 24px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; }\n.checkout h3 { margin: 0 0 2px; font-size: 16px; }\n.checkout label, #productForm label { display: flex; flex-direction: column; gap: 5px; font-size: 13px; color: var(--muted); }\n.checkout input, .checkout textarea,\n#productForm input, #productForm textarea {\n  padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; background: #fff;\n}\n.form-msg { margin: 4px 0 0; font-size: 13px; min-height: 18px; }\n.form-msg.error { color: var(--red); }\n.form-msg.ok { color: var(--green); }\n\n/* ---------- product modal ---------- */\n.modal {\n  background: #fff; border-radius: var(--radius); width: min(760px, 92%);\n  max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-lg);\n}\n.modal-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }\n.modal img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px 0 0 12px; }\n.modal-info { padding: 28px; display: flex; flex-direction: column; gap: 10px; }\n\n/* ---------- admin ---------- */\n.admin { padding-bottom: 60px; }\n.admin-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin: 26px 0 18px; }\n.admin-head h1 { margin: 0; }\n.token-row { display: flex; align-items: center; gap: 10px; }\n.token-row input { padding: 9px 12px; border: 1px solid var(--line); border-radius: 8px; width: 260px; }\n.muted { color: var(--muted); font-size: 14px; }\n.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 22px; }\n.stat { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; }\n.stat .n { font-size: 26px; font-weight: 700; }\n.stat .l { color: var(--muted); font-size: 13px; margin-top: 4px; }\n.admin-grid { display: grid; grid-template-columns: 360px 1fr; gap: 20px; margin-bottom: 22px; align-items: start; }\n#productForm { padding: 20px; display: flex; flex-direction: column; gap: 12px; }\n#productForm h3 { margin: 0; }\n.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n.form-actions { display: flex; gap: 10px; margin-top: 4px; }\n.table-card, .admin > .card { padding: 20px; }\n.table-card h3, .admin > .card h3 { margin: 0 0 14px; }\n.table-scroll { overflow-x: auto; }\ntable { width: 100%; border-collapse: collapse; font-size: 14px; }\nth, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); }\nth { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }\ntr:hover td { background: #fafbfc; }\n.mini-btn { border: 1px solid var(--line); background: #fff; border-radius: 6px; padding: 4px 10px; font-size: 13px; }\n.mini-btn:hover { background: #f3f4f7; }\n.mini-btn.danger { color: var(--red); border-color: #f0c8c2; }\n.pill { font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: 999px; background: #e8f5ee; color: var(--green); }\n.pill.low { background: #fdeceb; color: var(--red); }\n\n/* ---------- toast ---------- */\n.toast {\n  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);\n  background: #131a26; color: #fff; padding: 13px 22px; border-radius: 10px;\n  box-shadow: var(--shadow-lg); z-index: 90; font-weight: 600;\n}\n\n@media (max-width: 780px) {\n  .hero { flex-direction: column; align-items: flex-start; padding: 28px 22px; }\n  .hero h1 { font-size: 26px; }\n  .admin-grid { grid-template-columns: 1fr; }\n  .modal-inner { grid-template-columns: 1fr; }\n  .modal img { border-radius: 12px 12px 0 0; aspect-ratio: 4/3; }\n  .search { order: 3; width: 100%; max-width: none; }\n  .topbar-inner { flex-wrap: wrap; height: auto; padding: 10px 0; }\n}\n'}
