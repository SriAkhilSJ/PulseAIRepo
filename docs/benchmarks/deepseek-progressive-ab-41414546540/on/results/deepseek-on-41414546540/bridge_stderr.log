cky;top:90px;}\n  aside h3{margin:0 0 12px;font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);}\n  .catitem{display:flex;justify-content:space-between;width:100%;text-align:left;background:none;border:0;\n           padding:9px 10px;border-radius:8px;color:var(--ink);font-size:14px;}\n  .catitem:hover{background:#f3f4f6;}\n  .catitem.active{background:var(--brand);color:#fff;font-weight:700;}\n  .catitem small{opacity:.7;}\n  .toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap;}\n  .toolbar h2{margin:0;font-size:22px;}\n  select{padding:9px 12px;border:1px solid var(--line);border-radius:9px;background:#fff;font-size:14px;}\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:18px;}\n  .card{background:var(--surface);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;\n        display:flex;flex-direction:column;transition:transform .15s,box-shadow .15s;}\n  .card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,0,0,.12);}\n  .thumb{font-size:58px;text-align:center;padding:18px 0;background:#f9fafb;border-radius:10px;margin-bottom:12px;}\n  .card h4{margin:0 0 6px;font-size:15px;line-height:1.35;min-height:40px;}\n  .cat-tag{font-size:11px;color:var(--brand);font-weight:700;text-transform:uppercase;letter-spacing:.05em;}\n  .stars{color:var(--accent);font-size:13px;margin:4px 0;}\n  .stars small{color:var(--muted);margin-left:4px;}\n  .price{font-size:19px;font-weight:800;margin:6px 0;}\n  .stock{font-size:12px;color:var(--muted);margin-bottom:10px;}\n  .stock.low{color:var(--danger);font-weight:700;}\n  .add{margin-top:auto;background:var(--brand);color:#fff;border:0;padding:11px;border-radius:9px;font-weight:700;}\n  .add:hover{background:var(--brand-dark);}\n  .add:disabled{background:#d1d5db;cursor:not-allowed;}\n  .empty{padding:60px 20px;text-align:center;color:var(--muted);background:#fff;border-radius:var(--radius);}\n  /* cart drawer */\n  .overlay{position:fixed;inset:0;background:rgba(15,23,42,.5);opacity:0;pointer-events:none;transition:opacity .2s;z-index:90;}\n  .overlay.show{opacity:1;pointer-events:auto;}\n  .drawer{position:fixed;top:0;right:0;height:100%;width:min(420px,100%);background:#fff;z-index:100;\n          transform:translateX(100%);transition:transform .25s;display:flex;flex-direction:column;box-shadow:-8px 0 30px rgba(0,0,0,.2);}\n  .drawer.show{transform:translateX(0);}\n  .drawer header{background:#fff;color:var(--ink);padding:18px 20px;display:flex;justify-content:space-between;align-items:center;\n                 border-bottom:1px solid var(--line);box-shadow:none;}\n  .drawer header h3{margin:0;font-size:18px;}\n  .close{background:none;border:0;font-size:24px;line-height:1;color:var(--muted);}\n  .cartlist{flex:1;overflow-y:auto;padding:14px 20px;}\n  .citem{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);}\n  .citem .em{font-size:30px;}\n  .citem .meta{flex:1;}\n  .citem .meta b{font-size:14px;display:block;margin-bottom:4px;}\n  .qty{display:flex;align-items:center;gap:6px;margin-top:6px;}\n  .qty button{width:26px;height:26px;border-radius:6px;border:1px solid var(--line);background:#f9fafb;font-weight:700;}\n  .rm{background:none;border:0;color:var(--danger);font-size:12px;font-weight:600;margin-left:auto;}\n  .cartfoot{padding:18px 20px;border-top:1px solid var(--line);background:#f9fafb;}\n  .row{display:flex;justify-content:space-between;margin-bottom:8px;font-size:14px;color:var(--muted);}\n  .row.total{font-size:19px;font-weight:800;color:var(--ink);margin-top:10px;}\n  .checkout{width:100%;background:var(--accent);border:0;color:#111;padding:14px;border-radius:10px;font-weight:800;font-size:16px;margin-top:12px;}\n  /* modal */\n  .modal{position:fixed;inset:0;background:rgba(15,23,42,.6);display:none;align-items:center;justify-content:center;z-index:110;padding:20px;}\n  .modal.show{display:flex;}\n  .modal-box{background:#fff;border-radius:16px;padding:28px;width:min(460px,100%);max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3);}\n  .modal-box h3{margin:0 0 18px;font-size:20px;}\n  .field{margin-bottom:14px;}\n  .field label{display:block;font-size:13px;font-weight:600;margin-bottom:6px;color:#374151;}\n  .field input,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:9px;font-size:14px;font-family:inherit;}\n  .field input:focus,.field textarea:focus{outline:2px solid var(--brand);border-color:var(--brand);}\n  .btn-primary{width:100%;background:var(--brand);color:#fff;border:0;padding:13px;border-radius:10px;font-weight:700;font-size:15px;}\n  .btn-primary:hover{background:var(--brand-dark);}\n  .btn-ghost{background:#f3f4f6;border:1px solid var(--line);padding:11px 16px;border-radius:9px;font-weight:600;}\n  .msg{padding:10px 12px;border-radius:8px;font-size:13px;margin-bottom:14px;display:none;}\n  .msg.err{display:block;background:#fef2f2;color:var(--danger);border:1px solid #fecaca;}\n  .msg.ok{display:block;background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0;}\n  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:#111827;color:#fff;\n         padding:13px 22px;border-radius:999px;font-weight:600;z-index:200;transition:transform .25s;box-shadow:var(--shadow);}\n  .toast.show{transform:translateX(-50%) translateY(0);}\n  /* admin */\n  .admin{max-width:1240px;margin:0 auto;padding:24px 20px 60px;display:none;}\n  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:24px;}\n  .stat{background:#fff;border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);}\n  .stat b{display:block;font-size:28px;font-weight:800;color:var(--brand);}\n  .stat small{color:var(--muted);font-size:13px;}\n  table{width:100%;border-collapse:collapse;background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);margin-bottom:24px;}\n  th,td{padding:12px 14px;text-align:left;font-size:14px;border-bottom:1px solid var(--line);}\n  th{background:#f9fafb;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);}\n  tr:last-child td{border-bottom:0;}\n  .pill{padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;}\n  .pill.placed{background:#dbeafe;color:#1e40af;}\n  .pill.shipped{background:#fef3c7;color:#92400e;}\n  .pill.delivered{background:#d1fae5;color:#065f46;}\n  .pill.cancelled{background:#fee2e2;color:#991b1b;}\n  .rowbtns{display:flex;gap:6px;flex-wrap:wrap;}\n  .mini{padding:6px 11px;border:1px solid var(--line);background:#fff;border-radius:7px;font-size:13px;font-weight:600;}\n  .mini.danger{color:var(--danger);border-color:#fecaca;}\n  .mini.primary{background:var(--brand);color:#fff;border:0;}\n  .card-panel{background:#fff;border-radius:var(--radius);padding:22px;box-shadow:var(--shadow);margin-bottom:24px;}\n  .card-panel h3{margin:0 0 16px;font-size:17px;}\n  .formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;}\n  @media(max-width:820px){.layout{grid-template-columns:1fr;}aside{position:static;}header .bar{gap:10px;}}\n</style>\n</head>\n<body>\n\n<header>\n  <div class="bar">\n    <div class="logo">🛍️ Pulse<span>Cart</span></div>\n    <div class="search">\n      <input id="q" type="search" placeholder="Search products, brands and categories…" />\n      <button onclick="Store.search()">Search</button>\n    </div>\n    <div class="hbtns">\n      <button class="hbtn" onclick="Store.toggleAdmin()" id="adminBtn">⚙️ Admin</button>\n      <button class="hbtn" onclick="Store.openCart()">🛒 Cart<span class="badge" id="cartBadge">0</span></button>\n    </div>\n  </div>\n</header>\n\n<!-- Storefront -->\n<main class="layout" id="storeView">\n  <aside>\n    <h3>Categories</h3>\n    <button class="catitem active" data-cat="" onclick="Store.setCategory(\'\',this)">All Products</button>\n    <div id="catList"></div>\n  </aside>\n  <section>\n    <div class="toolbar">\n      <h2 id="resultTitle">All Products</h2>\n      <select id="sort" onchange="Store.loadProducts()">\n        <option value="relevance">Sort: Top rated</option>\n        <option value="price_asc">Price: Low to high</option>\n        <option value="price_desc">Price: High to low</option>\n        <option value="newest">Newest arrivals</option>\n      </select>\n    </div>\n    <div class="grid" id="grid"></div>\n  </section>\n</main>\n\n<!-- Admin hub -->\n<main class="admin" id="adminView">\n  <div class="toolbar">\n    <h2>⚙️ Admin Hub</h2>\n    <button class="btn-ghost" onclick="Store.toggleAdmin()">← Back to store</button>\n  </div>\n  <div id="adminStatus" class="msg"></div>\n  <div class="stats">\n    <div class="stat"><b id="sProducts">–</b><small>Active products</small></div>\n    <div class="stat"><b id="sOrders">–</b><small>Total orders</small></div>\n    <div class="stat"><b id="sRevenue">–</b><small>Revenue</small></div>\n  </div>\n\n  <div class="card-panel">\n    <h3>Add a product</h3>\n    <div class="formgrid">\n      <input id="npTitle" placeholder="Title" />\n      <input id="npPrice" type="number" min="0" step="0.01" placeholder="Price ($)" />\n      <input id="npStock" type="number" min="0" placeholder="Stock" />\n      <input id="npEmoji" placeholder="Emoji 🎁" maxlength="4" />\n      <select id="npCat"></select>\n      <button class="btn-primary" style="width:auto" onclick="Store.addProduct()">+ Add product</button>\n    </div>\n  </div>\n\n  <h3 style="margin:0 0 12px;">Inventory</h3>\n  <table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead>\n  <tbody id="invBody"></tbody></table>\n\n  <h3 style="margin:0 0 12px;">Orders</h3>\n  <table><thead><tr><th>Ref</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead>\n  <tbody id="ordBody"></tbody></table>\n</main>\n\n<!-- Cart drawer -->\n<div class="overlay" id="overlay" onclick="Store.closeAll()"></div>\n<div class="drawer" id="drawer">\n  <header><h3>Your Cart</h3><button class="close" onclick="Store.closeAll()">×</button></header>\n  <div class="cartlist" id="cartList"></div>\n  <div class="cartfoot" id="cartFoot"></div>\n</div>\n\n<!-- Checkout modal -->\n<div class="modal" id="checkoutModal">\n  <div class="modal-box">\n    <h3>Checkout</h3>\n    <div id="coMsg" class="msg"></div>\n    <div class="field"><label>Full name</label><input id="coName" placeholder="Ada Lovelace" /></div>\n    <div class="field"><label>Email</label><input id="coEmail" type="email" placeholder="ada@example.com" /></div>\n    <div class="field"><label>Shipping address</label><textarea id="coAddr" rows="3" placeholder="221B Baker Street, London"></textarea></div>\n    <button class="btn-primary" onclick="Store.checkout()">Place order</button>\n    <button class="btn-ghost" style="width:100%;margin-top:10px;" onclick="Store.closeAll()">Cancel</button>\n  </div>\n</div>\n\n<!-- Success modal -->\n<div class="modal" id="successModal">\n  <div class="modal-box" style="text-align:center">\n    <div style="font-size:56px">🎉</div>\n    <h3>Order placed!</h3>\n    <p style="color:#6b7280">Your order reference is <b id="succRef" style="color:#111"></b>.<br>A confirmation was sent to your email.</p>\n    <button class="btn-primary" onclick="Store.closeAll()">Continue shopping</button>\n  </div>\n</div>\n\n<div class="toast" id="toast"></div>\n\n<script>\nconst API = "";\nconst Store = {\n  state: { products: [], categories: [], cart: {items:[],count:0,total:0}, category: "", search: "", admin: false },\n  token: localStorage.getItem("pulsecart_token") || "",\n  adminKey: localStorage.getItem("pulsecart_admin") || "admin-secret",\n\n  async api(path, opts = {}) {\n    const headers = { "Content-Type": "application/json" };\n    if (this.token) headers["X-Cart-Token"] = this.token;\n    if (this.state.admin) headers["X-Admin-Key"] = this.adminKey;\n    const res = await fetch(API + path, { ...opts, headers: { ...headers, ...(opts.headers||{}) } });\n    const data = await res.json().catch(() => ({}));\n    if (!res.ok) throw new Error(data.error || ("HTTP " + res.status));\n    return data;\n  },\n\n  money(n) { return "$" + Number(n).toFixed(2); },\n  stars(r) {\n    const full = Math.floor(r), half = r - full >= 0.5;\n    return "★".repeat(full) + (half ? "½" : "") + "☆".repeat(5 - full - (half ? 1 : 0));\n  },\n  toast(text) {\n    const t = document.getElementById("toast");\n    t.textContent = text; t.classList.add("show");\n    clearTimeout(this._t); this._t = setTimeout(() => t.classList.remove("show"), 2200);\n  },\n\n  async init() {\n    await Promise.all([this.loadCategories(), this.loadProducts(), this.refreshCart()]);\n    document.getElementById("q").addEventListener("keydown", e => { if (e.key === "Enter") this.search(); });\n  },\n\n  async loadCategories() {\n    const { categories } = await this.api("/api/categories");\n    this.state.categories = categories;\n    document.getElementById("catList").innerHTML = categories.map(c =>\n      `<button class="catitem" data-cat="${c.slug}" onclick="Store.setCategory(\'${c.slug}\',this)">\n        ${c.name} <small>${c.product_count}</small></button>`).join("");\n    document.getElementById("npCat").innerHTML = categories.map(c =>\n      `<option value="${c.id}">${c.name}</option>`).join("");\n  },\n\n  async loadProducts() {\n    const p = new URLSearchParams();\n    if (this.state.search) p.set("search", this.state.search);\n    if (this.state.category) p.set("category", this.state.category);\n    p.set("sort", document.getElementById("sort").value);\n    const { products } = await this.api("/api/products?" + p.toString());\n    this.state.products = products;\n    document.getElementById("grid").innerHTML = products.length ? products.map(x => `\n      <div class="card">\n        <div class="thumb">${x.image_emoji}</div>\n        <span class="cat-tag">${x.category}</span>\n        <h4>${x.title}</h4>\n        <div class="stars">${this.stars(x.rating)}<small>${x.rating.toFixed(1)}</small></div>\n        <div class="price">${this.money(x.price)}</div>\n        <div class="stock ${x.stock <= 15 ? \'low\' : \'\'}">${x.stock > 0 ? (x.stock <= 15 ? \'Only \' + x.stock + \' left\' : \'In stock\') : \'Out of stock\'}</div>\n        <button class="add" ${x.stock === 0 ? "disabled" : ""} onclick="Store.addToCart(${x.id})">\n          ${x.stock === 0 ? "Unavailable" : "Add to cart"}</button>\n      </div>`).join("") : `<div class="empty" style="grid-column:1/-1">🔍 No products matched your search.</div>`;\n    document.getElementById("resultTitle").textContent =\n      this.state.category ? (categories.find(c => c.slug === this.state.category)?.name || "Products") + " (" + products.length + ")" : "All Products (" + products.length + ")";\n  },\n\n  setCategory(slug, el) {\n    this.state.category = slug; this.state.search = "";\n    document.getElementById("q").value = "";\n    document.querySelectorAll(".catitem").forEach(b => b.classList.remove("active"));\n    el.classList.add("active");\n    this.loadProducts();\n  },\n\n  search() { this.state.search = document.getElementById("q").value.trim(); this.loadProducts(); },\n\n  /* ---- cart ---- */\n  async refreshCart() {\n    const c = await this.api("/api/cart" + (this.token ? "" : ""));\n    if (c.cart_token) { this.token = c.cart_token; localStorage.setItem("pulsecart_token", this.token); }\n    this.state.cart = c;\n    document.getElementById("cartBadge").textContent = c.count;\n-end  this.renderCart(c);\n  },\n\n  renderCart(c) {\n    const list = document.getElementById("cartList"), foot = document.getElementById("cartFoot");\n    if (!c.items.length) {\n      list.innerHTML = `<div class="empty" style="box-shadow:none">Your cart is empty 🛒</div>`;\n      foot.innerHTML = ""; return;\n    }\n    list.innerHTML = c.items.map(i => `\n      <div class="citem">\n        <div class="em">${i.image_emoji}</div>\n        <div class="meta">\n          <b>${i.title}</b>\n          <div>${this.money(i.price)} ea.</div>\n          <div class="qty">\n            <button onclick="Store.setQty(${i.item_id},${i.qty - 1})">−</button>\n            <span>${i.qty}</span>\n            <button onclick="Store.setQty(${i.item_id},${i.qty + 1})">+</button>\n            <button class="rm" onclick="Store.removeItem(${i.item_id})">Remove</button>\n          </div>\n        </div>\n        <b>${this.money(i.line_total)}</b>\n      </div>`).join("");\n    foot.innerHTML = `\n      <div class="row"><span>Subtotal</span><span>${this.money(c.subtotal)}</span></div>\n      <div class="row"><span>Shipping</span><span>${c.shipping === 0 ? "FREE" : this.money(c.shipping)}</span></div>\n      <div class="row total"><span>Total</span><span>${this.money(c.total)}</span></div>\n      <button class="checkout" onclick="Store.openCheckout()">Proceed to checkout</button>`;\n  },\n\n  async addToCart(pid) {\n    try {\n      const c = await this.api("/api/cart/items", { method: "POST", body: JSON.stringify({ product_id: pid, qty: 1, cart_token: this.token }) });\n      this.token = c.cart_token; localStorage.setItem("pulsecart_token", this.token);\n      this.state.cart = c; document.getElementById("cartBadge").textContent = c.count; this.renderCart(c);\n      this.toast("Added to cart ✓");\n    } catch (e) { this.toast("⚠ " + e.message); }\n  },\n  async setQty(itemId, qty) {\n    const c = await this.api(`/api/cart/items/${itemId}`, { method: "PUT", body: JSON.stringify({ qty, cart_token: this.token }) });\n    this.state.cart = c; document.getElementById("cartBadge").textContent = c.count; this.renderCart(c);\n    if (qty <= 0) this.loadProducts();\n  },\n  async removeItem(itemId) {\n    const c = await this.api(`/api/cart/items/${itemId}`, { method: "DELETE" });\n    this.state.cart = c; document.getElementById("cartBadge").textContent = c.count; this.renderCart(c);\n    this.loadProducts();\n  },\n\n  openCart() { document.getElementById("overlay").classList.add("show"); document.getElementById("drawer").classList.add("show"); },\n  openCheckout() {\n    if (!this.state.cart.items.length) return this.toast("Cart is empty");\n    document.getElementById("overlay").classList.add("show");\n    document.getElementById("checkoutModal").classList.add("show");\n  },\n  closeAll() {\n    document.getElementById("overlay").classList.remove("show");\n    document.getElementById("drawer").classList.remove("show");\n    document.getElementById("checkoutModal").classList.remove("show");\n    document.getElementById("successModal").classList.remove("show");\n  },\n\n  async checkout() {\n    const msg = document.getElementById("coMsg"); msg.className = "msg";\n    try {\n      const r = await this.api("/api/checkout", { method: "POST", body: JSON.stringify({\n        cart_token: this.token,\n        name: document.getElementById("coName").value,\n        email: document.getElementById("coEmail").value,\n        address: document.getElementById("coAddr").value,\n      })});\n      this.closeAll();\n      document.getElementById("succRef").textContent = r.order_ref;\n      document.getElementById("overlay").classList.add("show");\n      document.getElementById("successModal").classList.add("show");\n      document.getElementById("coName").value = document.getElementById("coEmail").value = document.getElementById("coAddr").value = "";\n      await this.refreshCart(); await this.loadProducts();\n    } catch (e) { msg.className = "msg err"; msg.textContent = e.message; }\n  },\n\n  /* ---- admin ---- */\n  async toggleAdmin() {\n    this.state.admin = !this.state.admin;\n    document.getElementById("storeView").style.display = this.state.admin ? "none" : "";\n    document.getElementById("adminView").style.display = this.state.admin ? "block" : "none";\n    document.getElementById("adminBtn").textContent = this.state.admin ? "🏠 Storefront" : "⚙️ Admin";\n    if (this.state.admin) await this.loadAdmin();\n  },\n\n  adminMsg(text, ok = true) {\n    const el = document.getElementById("adminStatus");\n    el.className = "msg " + (ok ? "ok" : "err"); el.textContent = text;\n    setTimeout(() => { el.className = "msg"; }, 3000);\n  },\n\n  async loadAdmin() {\n    try {\n      const stats = await this.api("/api/admin/stats");\n      document.getElementById("sProducts").textContent = stats.products;\n      document.getElementById("sOrders").textContent = stats.orders;\n      document.getElementById("sRevenue").textContent = this.money(stats.revenue);\n\n      const { products } = await this.api("/api/products?sort=newest");\n      document.getElementById("invBody").innerHTML = products.map(p => `\n        <tr>\n          <td><b>${p.image_emoji} ${p.title}</b></td>\n          <td>${p.category}</td>\n          <td>${this.money(p.price)}</td>\n          <td class="${p.stock <= 15 ? \'\' : \'\'}"><input type="number" value="${p.stock}" min="0"\n              style="width:80px;padding:6px;border:1px solid #e5e7eb;border-radius:6px"\n              onchange="Store.updateStock(${p.id}, this.value)" /></td>\n          <td><div class="rowbtns">\n            <button class="mini" onclick="Store.editPrice(${p.id}, ${p.price_cents})">Price</button>\n            <button class="mini danger" onclick="Store.deleteProduct(${p.id})">Delete</button>\n          </div></td>\n        </tr>`).join("") || `<tr><td colspan="5">No products.</td></tr>`;\n\n      const { orders } = await this.api("/api/orders");\n      document.getElementById("ordBody").innerHTML = orders.map(o => `\n        <tr>\n          <td><b>${o.order_ref}</b><br><small style="color:#6b7280">${new Date(o.created_at).toLocaleDateString()}</small></td>\n          <td>${o.customer_name}<br><small style="color:#6b7280">${o.email}</small></td>\n          <td>${o.items.map(i => `${i.qty}× ${i.title_snapshot}`).join("<br>")}</td>\n          <td>${this.money(o.total)}</td>\n          <td><span class="pill ${o.status}">${o.status}</span></td>\n          <td><div class="rowbtns">\n            ${["shipped","delivered","cancelled"].map(s => s !== o.status ?\n              `<button class="mini" onclick="Store.setOrderStatus(${o.id},\'${s}\')">${s}</button>` : "").join("")}\n          </div></td>\n        </tr>`).join("") || `<tr><td colspan="6">No orders yet.</td></tr>`;\n    } catch (e) { this.adminMsg("Admin error: " + e.message, false); }\n  },\n\n  async updateStock(id, value) {\n    try { await this.api(`/api/products/${id}`, { method: "PUT", body: JSON.stringify({ stock: parseInt(value) }) });\n      this.adminMsg("Stock updated ✓"); await this.loadProducts(); }\n    catch (e) { this.adminMsg(e.message, false); }\n  },\n  async editPrice(id, currentCents) {\n    const dollars = prompt("New price in dollars:", (currentCents / 100).toFixed(2));\n    if (dollars === null) return;\n    const cents = Math.round(parseFloat(dollars) * 100);\n    if (isNaN(cents) || cents < 0) return this.adminMsg("Invalid price", false);\n    try { await this.api(`/api/products/${id}`, { method: "PUT", body: JSON.stringify({ price_cents: cents }) });\n      this.adminMsg("Price updated ✓"); await this.loadAdmin(); await this.loadProducts(); }\n    catch (e) { this.adminMsg(e.message, false); }\n  },\n  async deleteProduct(id) {\n    if (!confirm("Remove this product from the storefront?")) return;\n    try { await this.api(`/api/products/${id}`, { method: "DELETE" }); this.adminMsg("Product removed ✓");\n      await this.loadAdmin(); await this.loadProducts(); }\n    catch (e) { this.adminMsg(e.message, false); }\n  },\n  async setOrderStatus(id, status) {\n    try { await this.api(`/api/orders/${id}/status`, { method: "PUT", body: JSON.stringify({ status }) });\n      this.adminMsg("Order marked " + status + " ✓"); await this.loadAdmin(); }\n    catch (e) { this.adminMsg(e.message, false); }\n  },\n\n  async addProduct() {\n    const body = {\n      title: document.getElementById("npTitle").value.trim(),\n      price_cents: Math.round(parseFloat(document.getElementById("npPrice").value) * 100),\n      stock: parseInt(document.getElementById("npStock").value || "0"),\n      image_emoji: document.getElementById("npEmoji").value.trim() || "📦",\n      category_id: parseInt(document.getElementById("npCat").value),\n    };\n    if (!body.title || isNaN(body.price_cents)) return this.adminMsg("Title and price are required", false);\n    try {\n      await this.api("/api/products", { method: "POST", body: JSON.stringify(body) });\n      this.adminMsg("Product added ✓");\n      ["npTitle","npPrice","npStock","npEmoji"].forEach(id => document.getElementById(id).value = "");\n      await this.loadAdmin(); await this.loadProducts(); await this.loadCategories();\n    } catch (e) { this.adminMsg(e.message, false); }\n  },\n};\n\nStore.init();\n</script>\n</body>\n</html>\n', 'path': 'frontend/index.html'}
