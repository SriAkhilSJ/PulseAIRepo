🔧  edit_file {'new_text': '# ---------------------------------------------------------------- handlers\n\ndef api_register(body, user, params):\n    name = clean_str(body.get("name"), "Name", 80)\n    email = clean_str(body.get("email"), "Email", 120).lower()\n    password = body.get("password")\n    if not EMAIL_RE.match(email):\n        raise ApiError(400, "Enter a valid email address.")\n    if not isinstance(password, str) or len(password) < 6:\n        raise ApiError(400, "Password must be at least 6 characters.")\n    digest, salt = hash_password(password)\n    conn = get_db()\n    try:\n        if conn.execute("SELECT 1 FROM users WHERE email = ?", (email,)).fetchone():\n            raise ApiError(409, "An account with this email already exists.")\n        cur = conn.execute(\n            "INSERT INTO users (name, email, password_hash, salt, role, created_at) VALUES (?,?,?,?,\'customer\',?)",\n            (name, email, digest, salt, now_iso()),\n        )\n        conn.commit()\n        user_id = cur.lastrowid\n    finally:\n        conn.close()\n    token = create_session(user_id)\n    return 201, {"token": token, "user": {"id": user_id, "name": name, "email": email, "role": "customer"}}\n\n\ndef api_login(body, user, params):\n    email = clean_str(body.get("email"), "Email", 120).lower()\n    password = body.get("password")\n    if not isinstance(password, str):\n        raise ApiError(400, "Password is required.")\n    conn = get_db()\n    try:\n        row = conn.execute("SELECT * FROM users WHERE email = ?", (email,)).fetchone()\n    finally:\n        conn.close()\n    if not row or not verify_password(password, row["salt"], row["password_hash"]):\n        raise ApiError(401, "Incorrect email or password.")\n    token = create_session(row["id"])\n    return 200, {"token": token, "user": {"id": row["id"], "name": row["name"],\n                                          "email": row["email"], "role": row["role"]}}\n\n\ndef api_me(user, params):\n    conn = get_db()\n    try:\n        cart_count = conn.execute(\n            "SELECT COALESCE(SUM(qty),0) AS n FROM cart_items WHERE user_id = ?", (user["id"],)\n        ).fetchone()["n"]\n    finally:\n        conn.close()\n    return 200, {"user": user, "cart_count": cart_count}\n\n\ndef api_categories(user, params):\n    conn = get_db()\n    try:\n        cats = rows(conn.execute(\n            "SELECT DISTINCT category FROM products WHERE active = 1 ORDER BY category"))\n    finally:\n        conn.close()\n    return 200, {"categories": [c["category"] for c in cats]}\n\n\ndef api_products(user, params):\n    q = params.get("q", "").strip().lower()\n    category = params.get("category", "").strip()\n    sort = params.get("sort", "popular")\n    limit = to_int(params.get("limit", 60), "limit", 1, 200)\n    conn = get_db()\n    try:\n        sql = "SELECT * FROM products WHERE active = 1"\n        args = []\n        if q:\n            sql += " AND (LOWER(title) LIKE ? OR LOWER(description) LIKE ?)"\n            args += [f"%{q}%", f"%{q}%"]\n        if category:\n            sql += " AND category = ?"\n            args.append(category)\n        order = {"popular": "rating DESC", "price_asc": "price_cents ASC",\n                 "price_desc": "price_cents DESC"}.get(sort, "rating DESC")\n        sql += f" ORDER BY {order}"\n        products = rows(conn.execute(sql, args))\n        counts = {r["category"]: r["n"] for r in rows(conn.execute(\n            "SELECT category, COUNT(*) AS n FROM products WHERE active = 1 GROUP BY category"))}\n    finally:\n        conn.close()\n    result = [product_dict(p) for p in products[:limit]]\n    return 200, {"products": result, "total": len(result), "categories": counts}\n\n\ndef api_product_detail(user, params, product_id):\n    conn = get_db()\n    try:\n        row = conn.execute("SELECT * FROM products WHERE id = ? AND active = 1", (product_id,)).fetchone()\n    finally:\n        conn.close()\n    if not row:\n        raise ApiError(404, "Product not found.")\n    return 200, {"product": product_dict(row)}\n\n\n# __APPEND__', 'old_text': '# __APPEND__', 'path': 'server.py'}
