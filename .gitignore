# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv*/

.env


# Temp run artifacts
logs/

# Generated agent artifacts
generated/
*.log

# Tooling / IDE
venv/
.vscode/
.idea/
*.swp
*.tsbuildinfo
playwright-report/
test-results/

# OS metadata
.DS_Store
Thumbs.db

# Local PulseAI runtime state (if ever created repo-local)
.pulseai/

# VSCode fork (desktop/) build outputs — never vendor these
node_modules/
desktop/out/
desktop/out-build/
desktop/.build/

# Desktop fork (VS Code) — leftover artifacts not covered by its nested .gitignore
desktop/*.log
desktop/**/*.backup
desktop/_tmp_*
desktop/code-oss-dev@1.130.0
desktop/npm-run-all2

# Lab eval workspaces: never commit installed deps
lab/workspace_*/node_modules/
lab/npm-cache/
pytest-tmp/
lab/workspace_*/.next/
lab/workspace_*/dev.*
lab/workspace_*/*.pid
lab/*.start
lab/*.err
lab/*.err.log

# VS Code fork (desktop/vscode) — vendored source; nested .gitignore guards build outputs
desktop/vscode/.git/
desktop/vscode/**/.git/

# PulseAI IDE canonical fork. desktop/ tracks only fork metadata (README,
# manifest, pin, node version); desktop/vscode/ is the vendored Code OSS
# checkout with the Pulse overlay applied in place. Local dependencies and
# build outputs stay on disk for building, but are never committed.
desktop/*
!desktop/.nvmrc
!desktop/README.md
!desktop/SELECTIVE_MANIFEST.json
!desktop/UPSTREAM_PIN
!desktop/vscode/
!desktop/vscode/**

# Fork runtime artifacts the vendored nested .gitignore does not cover.
# node_modules/ and out*/ are already matched above; these own the rest.
desktop/vscode/**/.vscode/
desktop/vscode/build/*
!desktop/vscode/build/buildfile.ts
!desktop/vscode/build/next/
desktop/vscode/build/next/*
!desktop/vscode/build/next/index.ts
desktop/vscode/extensions/**/build/

# Scratch / local runtime state (never commit)
.freebuff/
claude_test/

# Benchmark run artifacts (design rule: results live outside git)
bench-results/
bench-archive*/

# Agent scratch: web image-search artifacts
image-search/

# pulseai-spa is now BUILT IN REPO (webapp/, hermes chat components) and the
# bundle is COMMITTED: pulseAIViewPane iframes it and the fork compile copies
# it src->out verbatim. The old pulse-webview postbuild that used to copy it
# in is gone — ignoring the src path is what left the Webview tab dead
# ("Not allowed to load local resource"). out/ stays ignored (compile output).
desktop/vscode/out/vs/workbench/contrib/pulseai/browser/media/pulseai-spa/
.reference/
