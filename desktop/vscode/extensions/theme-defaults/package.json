{
  "name": "theme-defaults",
  "displayName": "%displayName%",
  "description": "%description%",
  "categories": [
    "Themes"
  ],
  "version": "10.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "contributes": {
    "themes": [
      {
        "id": "CrusorAI Dark",
        "label": "%crusoraiDarkThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/crusorai-dark.json"
      },
      {
        "id": "Light 2026",
        "label": "%light2026ThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/2026-light.json"
      },
      {
        "id": "Dark 2026",
        "label": "%dark2026ThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/2026-dark.json"
      },
      {
        "id": "Dark+",
        "label": "%darkPlusColorThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dark_plus.json"
      },
      {
        "id": "Dark Modern",
        "label": "%darkModernThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dark_modern.json"
      },
      {
        "id": "Light+",
        "label": "%lightPlusColorThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/light_plus.json"
      },
      {
        "id": "Light Modern",
        "label": "%lightModernThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/light_modern.json"
      },
      {
        "id": "Visual Studio Dark",
        "label": "%darkColorThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dark_vs.json"
      },
      {
        "id": "Visual Studio Light",
        "label": "%lightColorThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/light_vs.json"
      },
      {
        "id": "Default High Contrast",
        "label": "%hcColorThemeLabel%",
        "uiTheme": "hc-black",
        "path": "./themes/hc_black.json"
      },
      {
        "id": "Default High Contrast Light",
        "label": "%lightHcColorThemeLabel%",
        "uiTheme": "hc-light",
        "path": "./themes/hc_light.json"
      }
    ],
    "iconThemes": [
      {
        "id": "vs-minimal",
        "label": "%minimalIconThemeLabel%",
        "path": "./fileicons/vs_minimal-icon-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "CrusorAI Dark",
      "workbench.colorCustomizations": {
        "editor.background": "#000000",
        "sideBar.background": "#000000",
        "sideBarSectionHeader.background": "#000000",
        "activityBar.background": "#000000",
        "titleBar.activeBackground": "#000000",
        "titleBar.inactiveBackground": "#000000",
        "statusBar.background": "#000000",
        "panel.background": "#000000",
        "editorGroupHeader.tabsBackground": "#000000",
        "tab.activeBackground": "#000000",
        "tab.inactiveBackground": "#000000",
        "menu.background": "#000000",
        "dropdown.background": "#000000",
        "input.background": "#000000",
        "editorWidget.background": "#000000",
        "editorSuggestWidget.background": "#000000",
        "editorHoverWidget.background": "#000000",
        "quickInput.background": "#000000",
        "notifications.background": "#000000",
        "notificationCenterHeader.background": "#000000",
        "breadcrumbPicker.background": "#000000",
        "peekViewTitle.background": "#000000",
        "terminal.background": "#000000",
        "button.background": "#000000",
        "button.secondaryBackground": "#000000",
        "list.activeSelectionBackground": "#262626",
        "foreground": "#FFFFFF",
        "editor.foreground": "#FFFFFF",
        "sideBar.foreground": "#FFFFFF",
        "titleBar.activeForeground": "#FFFFFF",
        "statusBar.foreground": "#FFFFFF",
        "icon.foreground": "#FFFFFF",
        "activityBar.foreground": "#FFFFFF",
        "activityBar.inactiveForeground": "#FFFFFF",
        "menu.foreground": "#FFFFFF",
        "menu.selectionForeground": "#FFFFFF",
        "input.foreground": "#FFFFFF",
        "dropdown.foreground": "#FFFFFF",
        "tab.activeForeground": "#FFFFFF",
        "button.foreground": "#FFFFFF",
        "button.secondaryForeground": "#FFFFFF"
      },
      "chat.disableAIFeatures": true,
      "chat.titleBar.signIn.enabled": false,
      "workbench.welcomePage.experimentalOnboarding": false,
      "workbench.startupEditor": "none",
      "workbench.welcomePage.walkthroughs.openOnInstall": false,
      "workbench.tips.enabled": true,
      "workbench.welcomePage.extraAnnouncements": false,
      "crusorai.hideBuiltInCopilotUI": true,
      "crusorai.copilotWebview.enabled": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
