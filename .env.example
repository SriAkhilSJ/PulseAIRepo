# Copy this file to .env and edit the values for your provider.

LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.6-27b

# Optional: tokenizer/context accounting model.
# If omitted, settings.py uses LLM_MODEL.
CONTEXT_MODEL=qwen/qwen3.6-27b

# API keys — fill only the provider you use.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# Optional: cheap model for janitor/management calls (Velona, OpenRouter, etc.)
CRUSORAI_CHEAP_API_KEY=
CRUSORAI_CHEAP_BASE_URL=
CRUSORAI_CHEAP_MODEL=

# --- CrusorAI Context Engine (all values stored in env, per user requirement) ---
# Global threshold percent: 0-1 or 0-100 (e.g. 75 or 0.75). Default 75% for IDE.
CRUSORAI_THRESHOLD_PERCENT=75
# Per-model overrides: JSON dict or csv k=v. Provider-scoped keys "provider:substr" outrank bare.
# Example: {"openai-codex:astra":0.85, "astra":0.80, "glm-5.2":0.40}
CRUSORAI_MODEL_THRESHOLDS=
# Proactive prune: cheap deterministic tool-result prune at low trigger (Hermes parity). 0=disabled.
CRUSORAI_PROACTIVE_PRUNE_TOKENS=0
CRUSORAI_PROACTIVE_PRUNE_MIN_CHARS=8000
CRUSORAI_PROACTIVE_PRUNE_MIN_RECLAIM=4096
# Protection window: how many first/last turns to keep verbatim
CRUSORAI_PROTECT_LAST_N=20
CRUSORAI_PROTECT_FIRST_N=3
# Context breakdown for IDE panel
CRUSORAI_CONTEXT_BREAKDOWN=on
# Micro-compaction OFF by default (breaks prompt cache each pass)
CRUSORAI_MICRO_COMPACTION=off
CRUSORAI_MICRO_COMPACTION_CADENCE=6
CRUSORAI_MICRO_COMPACTION_DEFRAG=2000
# Compression fence
CRUSORAI_COMPRESSION_IDLE_TIMEOUT=120
CRUSORAI_COMPRESSION_CEILING=600
CRUSORAI_COMPRESSION_LOCK_TTL=300
# Fallback chain: JSON list [{"provider":"openrouter","model":"..."}] or csv "model1,model2"
CRUSORAI_COMPRESSION_FALLBACK_CHAIN=
# IDE context injection
CRUSORAI_IDE_CONTEXT=off
CRUSORAI_EDITOR_CONTEXT_PATH=
CRUSORAI_REPO_MAP=off
CRUSORAI_VOLATILE_TAIL=on
# Max tools per turn: 0=unlimited, 32=recommended for DeepSeek models
CRUSORAI_MAX_TOOLS=0
# Long-term memory: OFF by default (desktop). ON requires embedder download (30s+ first boot, 204s trace).
# Enable only if you need persistent lessons: CRUSORAI_MEMORY=on
CRUSORAI_MEMORY=off
# Memory warmup budgets: per-call 0.35s (was 2.0s), init watchdog 30s (was 180s)
CRUSORAI_MEMORY_WARMUP_BUDGET_S=0.35
CRUSORAI_MEMORY_INIT_BUDGET_S=30
CRUSORAI_MEMORY_WARMUP_AT_BOOT=off
# --- Sub-agents (enterprise, local) ---
# Max delegation depth: 1 = main can spawn sub-agents, sub-agents cannot spawn further
CRUSORAI_SUBAGENT_DEPTH=1
# Allow sub-agents to run in background (async)
CRUSORAI_EXPERIMENTAL_BACKGROUND_SUBAGENTS=off
# --- Notifications ---
# Show Response Ready toast when agent finishes
CRUSORAI_NOTIFY_ON_COMPLETE=on
# --- Observability (local only, no upload — hermes relay-shared-metrics parity) ---
# Turn on to log latency/cost/tokens to ~/.crusorai/observability/turns.jsonl
CRUSORAI_OBSERVABILITY=off
CRUSORAI_OBSERVABILITY_PATH=
