diff --git a/desktop/vscode/scripts/audit-preview-pipeline.mjs b/desktop/vscode/scripts/audit-preview-pipeline.mjs
index 9c0df411..4a85ffec 100644
--- a/desktop/vscode/scripts/audit-preview-pipeline.mjs
+++ b/desktop/vscode/scripts/audit-preview-pipeline.mjs
@@ -28,20 +28,35 @@ try {
 console.log('git-tracked crusorai src files:', tracked.length);
 
 // ── 2. src <-> out mapping (ts -> js, media copied verbatim) ────────────────
-let missingOnDisk = 0, missingInOut = 0;
+// The emitter's rule is "everything non-.ts is copied verbatim" — so a
+// tracked source with no counterpart in out/ means the running app is
+// missing a file it loads by URL. Field 2026-09-27: that is exactly how the
+// preview window shipped blank (its index.html was in src/, never in out/,
+// and this audit listed the hole but still exited 0). The list is capped and
+// the verdict is at the bottom.
+let missingOnDisk = 0, missingInOut = 0, missingMedia = 0;
+const missingOutList = [];
 const outSet = new Set(list(OUT).map(p => path.relative(OUT, p).replace(/\\/g, '/')));
 for (const rel of tracked) {
   const abs = path.join(ROOT, rel);
   if (!fs.existsSync(abs)) { console.log('  SRC-MISSING-ON-DISK:', rel); missingOnDisk++; continue; }
   const outRel = rel.replace(/^src\//, 'out/').replace(/\.ts$/, '.js');
+  const isTs = rel.endsWith('.ts');
   if (!fs.existsSync(path.join(ROOT, outRel))) {
     // media and non-ts files keep their path verbatim under out/
     if (!outSet.has(rel.replace(/^src\//, 'out/').replace(/\\/g, '/'))) {
-      console.log('  OUT-MISSING:', outRel); missingInOut++;
+      missingOutList.push(outRel);
+      missingInOut++;
+      if (!isTs) missingMedia++;
     }
   }
 }
-console.log('src missing on disk:', missingOnDisk, '| tracked src w/o out counterpart:', missingInOut);
+for (const [i, f] of missingOutList.entries()) {
+  if (i < 20) console.log('  OUT-MISSING:', f);
+}
+if (missingOutList.length > 20) console.log(`  ... and ${missingOutList.length - 20} more`);
+console.log('src missing on disk:', missingOnDisk, '| tracked src w/o out counterpart:', missingInOut,
+  `(of which media the app loads by URL: ${missingMedia})`);
 
 // ── 3. src-on-disk files NOT tracked in git (user assets like crusorai-spa) ─
 const onDisk = list(SRC).map(p => path.relative(ROOT, p).replace(/\\/g, '/'));
@@ -60,8 +75,11 @@ const previewBits = [
   'out/vs/workbench/contrib/crusorai/common/crusorAIPreview.js',
 ];
 console.log('--- preview pipeline bits ---');
+let previewGone = 0;
 for (const b of previewBits) {
-  console.log(fs.existsSync(path.join(ROOT, b)) ? '  OK   ' + b : '  GONE ' + b);
+  const ok = fs.existsSync(path.join(ROOT, b));
+  if (!ok) previewGone++;
+  console.log(ok ? '  OK   ' + b : '  GONE ' + b);
 }
 
 // ── 5. stamps ───────────────────────────────────────────────────────────────
@@ -72,3 +90,18 @@ for (const s of ['SOURCES_HASH', 'BUILD_INFO.json']) {
     console.log('stamp', s, 'age_min=' + ageMin);
   } else console.log('stamp', s, 'MISSING');
 }
+
+// ── verdict ─────────────────────────────────────────────────────────────────
+// Exit non-zero on an incomplete out/ tree. "Reported but green" is what let
+// the blank preview ship: the app runs from out/, so a source with no
+// counterpart there is a missing feature, not a statistic.
+const failures = missingOnDisk + missingInOut + previewGone;
+if (failures) {
+  console.log('');
+  console.log(`AUDIT: FAIL (${failures} problem(s)) — out/ is not a complete image of src/.`);
+  console.log('FIX:   node scripts/emit-crusorai-bundle.mjs   (copies the media + re-emits the JS)');
+  process.exitCode = 1;
+} else {
+  console.log('');
+  console.log('AUDIT: OK — every tracked source has its counterpart in out/, preview bits all present.');
+}
diff --git a/desktop/vscode/scripts/emit-crusorai-bundle.mjs b/desktop/vscode/scripts/emit-crusorai-bundle.mjs
index ca4f88c5..36edaf89 100644
--- a/desktop/vscode/scripts/emit-crusorai-bundle.mjs
+++ b/desktop/vscode/scripts/emit-crusorai-bundle.mjs
@@ -82,6 +82,47 @@ function emit(dir) {
 }
 emit(SRC_ROOT);
 
+// Media — everything `tsc` can NEVER emit: the preview window's html/css/js
+// boot files, the workbench CSS, and the whole built crusorai-spa tree the
+// Agent pane iframes (index.html + hashed assets + fonts + icons).
+//
+// Field 2026-09-27, the blank-preview report: the app boots its preview
+// window with FileAccess.asBrowserUri('.../browser/media/crusor-preview/
+// index.html') — resolved against `out/`, the tree the app actually runs
+// from. This script copied ONLY `.ts`, so that path existed nowhere: the
+// button opened a window whose frame pointed at a missing file, the site
+// never rendered, and NOTHING failed loudly — the sources hash covers
+// SOURCES (media included, so it stayed green), the panel's own emit tests
+// only grepped JS, and `out/` is gitignored so no diff showed the hole.
+// The full fork build (`npm run compile` -> gulpfile.mjs copyResources)
+// was the only thing that ever wrote these files; every machine that
+// updated by pulling the committed bundle got the JS and none of the
+// media. Copy them here, VERBATIM (raw bytes — they are loaded as-is, and
+// an EOL rewrite would corrupt binary assets), and verify the copy so a
+// gap fails THIS script instead of failing quietly in the app.
+let mediaCount = 0;
+const mediaFailures = [];
+function copyMedia(dir) {
+	for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+		const src = path.join(dir, entry.name);
+		if (entry.isDirectory()) { copyMedia(src); continue; }
+		if (entry.name.endsWith('.ts')) { continue; }
+		const out = path.join(OUT_ROOT, path.relative(SRC_ROOT, src));
+		const bytes = fs.readFileSync(src);
+		fs.mkdirSync(path.dirname(out), { recursive: true });
+		fs.writeFileSync(out, bytes);
+		mediaCount += 1;
+		if (!fs.readFileSync(out).equals(bytes)) {
+			mediaFailures.push(path.relative(SRC_ROOT, src));
+		}
+	}
+}
+copyMedia(SRC_ROOT);
+if (mediaFailures.length) {
+	throw new Error(`[emit] refusing to ship: ${mediaFailures.length} media file(s) did not land in out/ byte-identical (${mediaFailures.slice(0, 5).join(', ')})`);
+}
+console.log(`[emit] copied ${mediaCount} media file(s) to out/ (css / html / preview boot files / crusorai-spa assets) — the panel and the preview window load these by URL`);
+
 // Sources hash: sha256 over EVERYTHING under the contrib tree (ts + css +
 // media — CSS changes the UI too) plus this script, in a deterministic
 // order. BUILD_INFO carries it and the ENGINE recomputes it from the pulled
diff --git a/src/tests/test_desktop_renderer_architecture.py b/src/tests/test_desktop_renderer_architecture.py
index 7f0ac6f8..f60ce2a8 100644
--- a/src/tests/test_desktop_renderer_architecture.py
+++ b/src/tests/test_desktop_renderer_architecture.py
@@ -1151,3 +1151,47 @@ def test_shipped_manifest_lets_the_engine_name_stale_files():
                                          / "contrib" / "crusorai" / "browser"
                                          / "SOURCES_HASH").read_text(encoding="utf-8").strip()
     assert isinstance(parsed.get("files"), dict) and parsed["files"]
+
