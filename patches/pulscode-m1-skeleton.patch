@@ -0,0 +1,43 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) CrusorCode. Licensed under the MIT License.
+ *  P2 M1 — the basic tool-call card (Kilo `basic-tool` / `tool-error-card`
+ *  design, native): header row (icon + tool name + status), expandable
+ *  body with args/result, error variant for refusals (D32 stale-write,
+ *  D34 batch refusals) and crashes (crash-net ToolMessages).
+ *--------------------------------------------------------------------------------------------*/
+
+import * as DOM from 'vs/base/browser/dom';
+
+export type CrusorToolCardState = 'running' | 'ok' | 'refused' | 'error';
+
+export interface CrusorToolCardData {
+	readonly name: string;
+	readonly state: CrusorToolCardState;
+	readonly summary: string;
+	readonly detail?: string;
+}
+
+const STATE_LABEL: Record<CrusorToolCardState, string> = {
+	running: '…',
+	ok: '✓',
+	refused: '🛑 refused',
+	error: '⛔ error',
+};
+
+/** Renders one tool card into `container`; returns the root element so
+ *  callers can replace it on tool_call_end. */
+export function renderToolCard(container: HTMLElement, data: CrusorToolCardData): HTMLElement {
+	const el = DOM.append(container, DOM.$(`.crusor-tool-card.crusor-tool-${data.state}`));
+	const head = DOM.append(el, DOM.$('.crusor-tool-head'));
+	DOM.append(head, DOM.$('.crusor-tool-state')).textContent = STATE_LABEL[data.state];
+	DOM.append(head, DOM.$('.crusor-tool-name')).textContent = data.name;
+	DOM.append(head, DOM.$('.crusor-tool-summary')).textContent = data.summary;
+	if (data.detail) {
+		head.classList.add('crusor-clickable');
+		head.title = 'Click to expand';
+		head.onclick = () => el.classList.toggle('crusor-open');
+		const body = DOM.append(el, DOM.$('.crusor-tool-body'));
+		body.textContent = data.detail;
+	}
+	return el;
+}
diff --git a/src/vs/workbench/contrib/crusor/browser/media/crusor.css b/src/vs/workbench/contrib/crusor/browser/media/crusor.css
