--- /dev/null
+++ b/src/vs/workbench/contrib/crusor/electron-browser/crusorEngineServiceImpl.ts
@@ -0,0 +1,121 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) CrusorCode. Licensed under the MIT License.
+ *  P2 M1 — engine service, node-side implementation SKELETON.
+ *
+ *  Integration note (fixed by the roadmap's 2-line rule): the frame
+ *  transport is an injectable seam (`ICrusorTransport`) so the process
+ *  attachment lands exactly once at M1 wiring — as a node-side channel
+ *  (same pattern the terminal's pty host uses via
+ *  src/vs/platform/terminal/node). Until then the service runs a
+ *  LoopbackTransport so the view is demoable end-to-end without an
+ *  engine process. No upstream files are edited.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Emitter } from 'vs/base/common/event';
+import { Disposable } from 'vs/base/common/lifecycle';
+import {
+	ICrusorEngineService,
+	CrusorEngineState,
+} from '../common/crusorEngineService.js';
+import {
+	CRUSOR_PROTOCOL_VERSION,
+	CrusorFrame,
+} from '../common/protocol.js';
+
+/** One decoded-frame transport under the service (stdio of the spawned
+ *  bridge; the loopback below implements it for the skeleton). */
+export interface ICrusorTransport {
+	write(frame: CrusorFrame): void;
+	onFrame(cb: (frame: CrusorFrame) => void): void;
+	onExit(cb: (code: number | null) => void): void;
+	dispose(): void;
+}
+
+/** Demo-only transport: answers hello from itself, echoes turn_done with
+ *  the honest stub flag. Lets M1 build the full UI loop with zero
+ *  engine; swapped for the real stdio transport at M1 wiring. */
+export class LoopbackTransport implements ICrusorTransport {
+	private frameCb: (frame: CrusorFrame) => void = () => undefined;
+	private exitCb: (code: number | null) => void = () => undefined;
+
+	write(frame: CrusorFrame): void {
+		if (frame['type'] === 'hello') {
+			this.frameCb({ type: 'hello', protocol: CRUSOR_PROTOCOL_VERSION, engine: 'crusorai', engine_version: 'loopback-skeleton' });
+		} else if (frame['type'] === 'prompt') {
+			this.frameCb({ type: 'turn_done', stub: true, thread_id: frame['thread_id'] ?? '', message: 'loopback transport — stdio engine wiring lands at M1' });
+		} else if (frame['type'] === 'shutdown') {
+			this.exitCb(0);
+		}
+	}
+	onFrame(cb: (frame: CrusorFrame) => void): void { this.frameCb = cb; }
+	onExit(cb: (code: number | null) => void): void { this.exitCb = cb; }
+	dispose(): void { /* nothing held */ }
+}
+
+export class CrusorEngineService extends Disposable implements ICrusorEngineService {
+	readonly _serviceBrand: undefined;
+
+	private readonly _onDidChangeState = this._register(new Emitter<CrusorEngineState>());
+	readonly onDidChangeState = this._onDidChangeState.event;
+	private readonly _onFrame = this._register(new Emitter<CrusorFrame>());
+	readonly onFrame = this._onFrame.event;
+
+	private _state: CrusorEngineState = 'stopped';
+	get state(): CrusorEngineState { return this._state; }
+
+	private transport: ICrusorTransport | undefined;
+
+	constructor(private readonly transportFactory: () => ICrusorTransport = () => new LoopbackTransport()) {
+		super();
+	}
+
+	async start(_workspace: string): Promise<void> {
+		if (this._state !== 'stopped' && this._state !== 'crashed') {
+			return;
+		}
+		this.setState('starting');
+		this.transport = this.transportFactory();
+		this.transport.onFrame(f => this.handleFrame(f));
+		this.transport.onExit(() => {
+			if (this._state !== 'stopped') {
+				this.setState('crashed');
+			}
+		});
+		this.transport.write({ type: 'hello', protocol: CRUSOR_PROTOCOL_VERSION });
+		// The hello reply flips us to 'ready' in handleFrame — with a
+		// mismatch guard: the frame must carry our protocol version.
+	}
+
+	send(frame: CrusorFrame): void {
+		if (this._state !== 'ready') {
+			throw new Error(`CrusorEngineService: cannot send while ${this._state}`);
+		}
+		this.transport?.write(frame);
+	}
+
+	async stop(): Promise<void> {
+		try {
+			this.transport?.write({ type: 'shutdown' });
+		} finally {
+			this.transport?.dispose();
+			this.transport = undefined;
+			this.setState('stopped');
+		}
+	}
+
+	private handleFrame(frame: CrusorFrame): void {
+		if (frame['type'] === 'hello') {
+			if (frame['protocol'] !== CRUSOR_PROTOCOL_VERSION) {
+				this.setState('crashed');
+				return;
+			}
+			this.setState('ready');
+		}
+		this._onFrame.fire(frame);
+	}
+
+	private setState(state: CrusorEngineState): void {
+		this._state = state;
+		this._onDidChangeState.fire(state);
+	}
+}
