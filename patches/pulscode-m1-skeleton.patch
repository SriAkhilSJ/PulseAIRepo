+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) CrusorCode. Licensed under the MIT License.
+ *  P2 M1 — the engine service INTERFACE (common layer). The spawn lives
+ *  on the node side; both sides speak bridge protocol v1.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Event } from 'vs/base/common/event';
+import { createDecorator } from 'vs/platform/instantiation/common/instantiation';
+import { CrusorFrame } from './protocol.js';
+
+export const ICrusorEngineService = createDecorator<ICrusorEngineService>('crusorEngineService');
+
+export type CrusorEngineState = 'stopped' | 'starting' | 'ready' | 'crashed';
+
+export interface ICrusorEngineService {
+	readonly _serviceBrand: undefined;
+
+	/** Fires whenever the engine process changes state. */
+	readonly onDidChangeState: Event<CrusorEngineState>;
+	/** Fires for every decoded bridge frame from the engine. */
+	readonly onFrame: Event<CrusorFrame>;
+
+	readonly state: CrusorEngineState;
+
+	/** Spawn `python -m src.bridge` in the given workspace and run the
+	 *  hello handshake. Rejects on protocol mismatch. */
+	start(workspace: string): Promise<void>;
+	/** Send one client frame (prompt / safety_reply / shutdown). */
+	send(frame: CrusorFrame): void;
+	/** Graceful shutdown (sends `shutdown`, then kills after grace). */
+	stop(): Promise<void>;
+}
diff --git a/src/vs/workbench/contrib/crusor/electron-browser/crusorEngineServiceImpl.ts b/src/vs/workbench/contrib/crusor/electron-browser/crusorEngineServiceImpl.ts
new file mode 100644
