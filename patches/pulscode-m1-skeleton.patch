@@ -0,0 +1,31 @@
+/* P2 M1 — Crusor chat view skeleton styles. VS Code theme variables only
+   (never hardcode colors — the fork ships with theme support for free). */
+
+.crusor-chat { display: flex; flex-direction: column; height: 100%; }
+
+.crusor-header { padding: 4px 8px; border-bottom: 1px solid var(--vscode-sideBarSectionHeader-border, transparent); }
+.crusor-status { font-size: 11px; color: var(--vscode-descriptionForeground); }
+
+.crusor-message-list { flex: 1; overflow-y: auto; padding: 8px; }
+.crusor-msg { margin: 4px 0; padding: 6px 8px; border-radius: 4px; white-space: pre-wrap; }
+.crusor-msg-user { background: var(--vscode-editor-inactiveSelectionBackground); }
+.crusor-msg-assistant { background: var(--vscode-editorWidget-background); }
+.crusor-msg-tool { font-family: var(--vscode-editor-font-family); font-size: 11px; color: var(--vscode-descriptionForeground); }
+
+/* Dock zone (M2 permission dock / M4 revert banner — Kilo "pinned above
+   input" rule from the UX study). */
+.crusor-dock { border-top: 1px solid var(--vscode-sideBarSectionHeader-border, transparent); }
+
+.crusor-prompt-row { padding: 8px; }
+.crusor-prompt { width: 100%; box-sizing: border-box; background: var(--vscode-input-background); color: var(--vscode-input-foreground); border: 1px solid var(--vscode-input-border, transparent); border-radius: 4px; resize: none; }
+.crusor-prompt:disabled { opacity: 0.6; }
+
+/* Tool cards */
+.crusor-tool-card { margin: 4px 0; border: 1px solid var(--vscode-editorWidget-border, transparent); border-radius: 4px; }
+.crusor-tool-head { display: flex; gap: 6px; padding: 4px 8px; align-items: center; font-family: var(--vscode-editor-font-family); font-size: 11px; }
+.crusor-tool-head.crusor-clickable { cursor: pointer; }
+.crusor-tool-ok .crusor-tool-state { color: var(--vscode-testing-iconPassed); }
+.crusor-tool-running .crusor-tool-state { color: var(--vscode-progressBar-background); }
+.crusor-tool-refused .crusor-tool-state, .crusor-tool-error .crusor-tool-state { color: var(--vscode-testing-iconFailed); }
+.crusor-tool-body { display: none; padding: 4px 8px; font-size: 11px; white-space: pre-wrap; border-top: 1px solid var(--vscode-editorWidget-border, transparent); }
+.crusor-tool-card.crusor-open .crusor-tool-body { display: block; }
