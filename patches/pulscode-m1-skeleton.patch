+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) CrusorCode. Licensed under the MIT License.
+ *  P2 M1 — Bridge protocol v1 (FROZEN, docs/P2-roadmap.md Phase 0.4).
+ *  Mirror of PulseAIRepo:src/bridge/protocol.py — keep the two in sync
+ *  by hand; any change is a roadmap amendment, not an edit.
+ *--------------------------------------------------------------------------------------------*/
+
+export const CRUSOR_PROTOCOL_VERSION = 1;
+
+export type CrusorClientMethod = 'hello' | 'prompt' | 'safety_reply' | 'shutdown';
+
+export type CrusorServerEvent =
+	| 'hello' | 'token' | 'tool_call_start' | 'tool_call_end'
+	| 'safety_request' | 'telemetry' | 'turn_done'
+	| 'checkpoint_event' | 'echo' | 'error';
+
+export interface CrusorHello {
+	readonly type: 'hello';
+	readonly protocol: number;
+	readonly engine?: 'crusorai';
+	readonly engine_version?: string;
+}
+
+export interface CrusorPrompt {
+	readonly type: 'prompt';
+	readonly text: string;
+	readonly workspace: string;
+	readonly thread_id: string;
+}
+
+export interface CrusorSafetyReply {
+	readonly type: 'safety_reply';
+	readonly request_id: string;
+	readonly approved: boolean;
+}
+
+export interface CrusorFrame {
+	readonly type: string;
+	readonly [key: string]: unknown;
+}
+
+export interface CrusorTurnDone {
+	readonly type: 'turn_done';
+	readonly thread_id: string;
+	/** Honest Phase-0 flag: true while the engine streaming wiring has
+	 *  not landed yet — the UI must badge stub turns, not present them
+	 *  as engine output. */
+	readonly stub?: boolean;
+	readonly message?: string;
+}
+
+export function isCrusorServerEvent(value: unknown): value is CrusorServerEvent {
+	return typeof value === 'string' && [
+		'hello', 'token', 'tool_call_start', 'tool_call_end',
+		'safety_request', 'telemetry', 'turn_done',
+		'checkpoint_event', 'echo', 'error',
+	].includes(value);
+}
