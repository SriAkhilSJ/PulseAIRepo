+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) CrusorCode. Licensed under the MIT License.
+ *  P2 M1 — the chat view skeleton: message list + input. Engine events
+ *  arrive later via CrusorEngineService (electron-browser). Layout and
+ *  dock zones follow the Kilo UX study (docs/P2-kilocode-ux-analysis.md):
+ *  header / timeline / messages / dock (permissions+questions+revert)
+ *  / prompt. For M1 the dock renders nothing — zones are placeholders
+ *  so M2-M4 fill slots, not redesign.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as DOM from 'vs/base/browser/dom';
+import { localize } from 'vs/nls';
+import { IViewPaneOptions, ViewPane } from 'vs/workbench/browser/parts/views/viewPane';
+import { IKeybindingService } from 'vs/platform/keybinding/common/keybinding';
+import { IContextMenuService } from 'vs/platform/contextview/browser/contextView';
+import { IConfigurationService } from 'vs/platform/configuration/common/configuration';
+import { IContextKeyService } from 'vs/platform/contextkey/common/contextkey';
+import { IViewDescriptorService } from 'vs/workbench/common/views';
+import { IInstantiationService } from 'vs/platform/instantiation/common/instantiation';
+import { IOpenerService } from 'vs/platform/opener/common/opener';
+import { IThemeService } from 'vs/platform/theme/common/themeService';
+import { IHoverService } from 'vs/platform/hover/browser/hover';
+
+export const CRUSOR_CHAT_VIEW_ID = 'crusor.chatView';
+
+export class CrusorChatViewPane extends ViewPane {
+	static readonly ID = CRUSOR_CHAT_VIEW_ID;
+
+	private listEl!: HTMLElement;
+	private promptEl!: HTMLTextAreaElement;
+	private statusEl!: HTMLElement;
+
+	constructor(
+		options: IViewPaneOptions,
+		@IKeybindingService keybindingService: IKeybindingService,
+		@IContextMenuService contextMenuService: IContextMenuService,
+		@IConfigurationService configurationService: IConfigurationService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IViewDescriptorService viewDescriptorService: IViewDescriptorService,
+		@IInstantiationService instantiationService: IInstantiationService,
+		@IOpenerService openerService: IOpenerService,
+		@IThemeService themeService: IThemeService,
+		@IHoverService hoverService: IHoverService,
+	) {
+		super(
+			options, keybindingService, contextMenuService, configurationService,
+			contextKeyService, viewDescriptorService, instantiationService,
+			openerService, themeService, hoverService,
+		);
+	}
+
+	protected override renderBody(container: HTMLElement): void {
+		super.renderBody(container);
+		const root = DOM.append(container, DOM.$('.crusor-chat'));
+
+		// Header (M3 slots: budget bar + usage card live here later).
+		const header = DOM.append(root, DOM.$('.crusor-header'));
+		this.statusEl = DOM.append(header, DOM.$('.crusor-status'));
+		this.statusEl.textContent = localize('crusor.status.offline', 'engine: not started');
+
+		// Message list (M1: chat round-trip renders here).
+		this.listEl = DOM.append(root, DOM.$('.crusor-message-list'));
+
+		// Dock zone (M2 permission dock / question dock, M4 revert banner —
+		//   the Kilo study's pinned-above-input rule; M1 keeps it empty).
+		DOM.append(root, DOM.$('.crusor-dock'));
+
+		// Prompt row.
+		const promptRow = DOM.append(root, DOM.$('.crusor-prompt-row'));
+		this.promptEl = DOM.append(promptRow, DOM.$('textarea.crusor-prompt'));
+		this.promptEl.placeholder = localize('crusor.prompt.placeholder', 'Ask Crusor to build, fix, or explain…');
+		this.promptEl.rows = 3;
+		this.promptEl.disabled = true; // enabled when the engine connects (M1 wiring)
+		this.promptEl.title = localize('crusor.prompt.disabled', 'Engine not connected yet — M1 wiring lands with CrusorEngineService');
+	}
+
+	protected override layoutBody(height: number, width: number): void {
+		super.layoutBody(height, width);
+		this.listEl.style.height = `${Math.max(0, height - 140)}px`;
+	}
+
+	/** M1 hook: engine service feeds frames here when wired. */
+	appendMessage(role: 'user' | 'assistant' | 'tool', text: string): void {
+		const row = DOM.append(this.listEl, DOM.$(`.crusor-msg.crusor-msg-${role}`));
+		row.textContent = text;
+		row.scrollIntoView({ block: 'end' });
+	}
+
+	setStatus(text: string): void {
+		this.statusEl.textContent = text;
+	}
+}
