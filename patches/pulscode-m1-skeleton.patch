+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) CrusorCode. Licensed under the MIT License.
+ *  P2 M1 — Crusor contrib registration. ONE import line added upstream
+ *  (workbench.common.main.ts) — the 2-line rule (roadmap) holds.
+ *--------------------------------------------------------------------------------------------*/
+
+import { localize, localize2 } from 'vs/nls';
+import { Codicon } from 'vs/base/common/codicons';
+import { SyncDescriptor } from 'vs/platform/instantiation/common/descriptors';
+import { Registry } from 'vs/platform/registry/common/platform';
+import {
+	Extensions as ViewContainerExtensions,
+	IViewContainersRegistry,
+	ViewContainerLocation,
+	Extensions as ViewsExtensions,
+	IViewsRegistry,
+} from 'vs/workbench/common/views';
+import { ViewPaneContainer } from 'vs/workbench/browser/parts/views/viewPaneContainer';
+import { registerAction2, Action2 } from 'vs/platform/actions/common/actions';
+import { ServicesAccessor } from 'vs/platform/instantiation/common/instantiation';
+import { IViewsService } from 'vs/workbench/services/views/common/viewsService';
+import { CrusorChatViewPane, CRUSOR_CHAT_VIEW_ID } from './crusorChatView.js';
+
+const CRUSOR_CONTAINER_ID = 'crusor';
+
+// 1) The Activity-bar container (single-view container, merges header).
+const container = Registry.as<IViewContainersRegistry>(
+	ViewContainerExtensions.ViewContainersRegistry
+).registerViewContainer(
+	{
+		id: CRUSOR_CONTAINER_ID,
+		title: localize2('crusor.viewContainer.title', 'Crusor'),
+		icon: Codicon.crusor,
+		ctorDescriptor: new SyncDescriptor(ViewPaneContainer, [
+			CRUSOR_CONTAINER_ID,
+			{ mergeViewWithContainerWhenSingleView: true },
+		]),
+	},
+	ViewContainerLocation.Sidebar
+);
+
+// 2) The chat view inside it.
+Registry.as<IViewsRegistry>(ViewsExtensions.ViewsRegistry).registerViews(
+	[
+		{
+			id: CRUSOR_CHAT_VIEW_ID,
+			name: localize('crusor.chatView.name', 'Crusor Agent'),
+			containerIcon: Codicon.crusor,
+			canToggleVisibility: true,
+			canMoveView: false,
+			ctorDescriptor: new SyncDescriptor(CrusorChatViewPane),
+		},
+	],
+	container
+);
+
+// 3) Command: focus the Crusor view (palette + keybinding hookup upstream
+//    stays untouched — commands surface via the palette automatically).
+registerAction2(
+	class OpenCrusorViewAction extends Action2 {
+		constructor() {
+			super({
+				id: 'crusor.focusChat',
+				title: localize2('crusor.focusChat.title', 'Crusor: Focus Agent Chat'),
+				f1: true,
+			});
+		}
+		run(accessor: ServicesAccessor): Promise<void> {
+			return accessor
+				.get(IViewsService)
+				.openView(CRUSOR_CHAT_VIEW_ID, true)
+				.then(() => undefined);
+		}
+	}
+);
