+        '"""Rate limiting."""\n\n'
+        "def throttle_request(req):\n"
+        '    """Apply the sliding window to this request."""\n'
+        "    return req\n"
+    )
+    ws = _mk_ws(
+        {"legacy_limiter.py": old, "limiter.py": new},
