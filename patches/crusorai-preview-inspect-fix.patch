+/*---------------------------------------------------------------------------------------------
+ * Crusor Preview window — chrome styling.
+ *
+ * Color discipline (browser/media/crusorAI-tokens.css, owner directive "don't hardcode plz"):
+ * every paint resolves --crusorai-* first, then the live workbench theme's --vscode-* chain,
+ * then a single documented seed. The host pushes the derived palette in on `configure`, so a
+ * theme change re-derives this surface exactly like the Agent pane.
+ *
+ * Type grammar: the host's own stacks, meta size 0.625rem, tabular numerals on counters,
+ * one caps tracking token.
+ *--------------------------------------------------------------------------------------------*/
+
+:root {
+	/* ── palette: derived, never hardcoded ─────────────────────────────────────────────── */
+	--cp-accent: var(--crusorai-accent, var(--vscode-focusBorder, var(--vscode-button-background, #fab283)));
