+		postToHost('review-submit', { batch: batch });
+		setState('pending', 'sent');
+		toast('Sent ' + batch.fixes.length + (batch.fixes.length === 1 ? ' fix' : ' fixes') + ' to Crusor', 'accent', 'send');
