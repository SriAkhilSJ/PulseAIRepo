+	}
+
+	reviewBtn.addEventListener('click', openSheet);
+	clearBtn.addEventListener('click', function () {
+		clearFixes();
+		postToOverlay('clear-pins', {});
+		toast('Pending fixes discarded', 'failed', 'trash');
