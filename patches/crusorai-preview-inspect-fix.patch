+	font-variant-numeric: tabular-nums;
+}
+
+.cpw-tray-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.cpw-tray-drop {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	width: 16px;
+	height: 16px;
+	flex: 0 0 auto;
+	padding: 0;
+	background: transparent;
+	border: 0;
+	border-radius: 3px;
+	color: var(--cp-text-micro);
+	cursor: pointer;
+}
+
+.cpw-tray-drop svg { width: 11px; height: 11px; }
+.cpw-tray-drop:hover { color: var(--cp-failed); }
+
+/* ── review sheet ──────────────────────────────────────────────────────────────────────── */
+.cpw-sheet-backdrop {
+	position: fixed;
+	inset: 0;
+	z-index: 40;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	padding: 20px;
+	background: color-mix(in srgb, #000 55%, transparent);
+	backdrop-filter: blur(2px);
+}
+
+.cpw-sheet-backdrop[hidden] { display: none; }
+
+.cpw-sheet {
+	display: flex;
+	flex-direction: column;
+	width: min(620px, 100%);
+	max-height: min(78vh, 680px);
+	background: var(--cp-surface);
+	border: 1px solid var(--cp-border);
+	border-radius: var(--cp-radius);
+	box-shadow: 0 24px 64px -12px rgba(0, 0, 0, .6);
+	overflow: hidden;
+}
+
+.cpw-sheet-head { position: relative; padding: 12px 40px 10px 14px; border-bottom: 1px solid var(--cp-border-weak); }
+.cpw-sheet-head h2 { margin: 0; font-size: var(--cp-text-title); font-weight: 500; }
+
