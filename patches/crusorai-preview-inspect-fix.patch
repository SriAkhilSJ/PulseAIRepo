+/* Lab fixture styling for "the UI the agent created". Deliberately its own light design system,
+   so the inspect overlay (dark, accent-derived) is unmistakably Crusor chrome and not page CSS. */
+
+:root {
+  --ink: #14161a;
+  --ink-soft: #4b5160;
+  --ink-faint: #7b8291;
+  --paper: #ffffff;
+  --paper-sunk: #f6f7f9;
+  --line: #e4e7ec;
+  --brand: #4f46e5;
+  --brand-soft: #eef0ff;
+  --radius: 10px;
+  --shadow-sm: 0 1px 2px rgba(16, 20, 28, .06);
+  --shadow-md: 0 10px 30px -12px rgba(16, 20, 28, .18);
+  --font: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
+}
+
+* { box-sizing: border-box; }
+
+html, body { margin: 0; padding: 0; }
+
+body {
+  background: var(--paper);
+  color: var(--ink);
+  font: 400 16px/1.6 var(--font);
+  -webkit-font-smoothing: antialiased;
+}
+
+a { color: inherit; text-decoration: none; }
+
+/* ── nav ─────────────────────────────────────────────────────────────────── */
+.nav {
+  display: flex;
+  align-items: center;
+  gap: 24px;
+  padding: 14px 32px;
+  border-bottom: 1px solid var(--line);
+  background: rgba(255, 255, 255, .92);
+  backdrop-filter: blur(8px);
+  position: sticky;
+  top: 0;
+  z-index: 5;
+}
+
+.brand { display: flex; align-items: center; gap: 9px; color: var(--brand); }
+.brand-mark { display: block; }
+.brand-name { font-size: 17px; font-weight: 650; letter-spacing: -.015em; color: var(--ink); }
+
+.nav-links { display: flex; align-items: center; gap: 20px; margin-left: 8px; }
+.nav-links a { font-size: 14.5px; color: var(--ink-soft); }
+.nav-links a:hover { color: var(--ink); }
+
+.nav-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
+
+/* ── buttons ─────────────────────────────────────────────────────────────── */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  height: 38px;
+  padding: 0 16px;
+  border-radius: var(--radius);
+  border: 1px solid transparent;
+  background: var(--paper-sunk);
+  color: var(--ink);
+  font: 550 14.5px/1 var(--font);
+  cursor: pointer;
+  transition: filter .14s ease, background .14s ease, border-color .14s ease;
+}
+
+.btn:hover { filter: brightness(.98); }
+.btn-primary { background: var(--brand); color: #fff; box-shadow: var(--shadow-sm); }
+.btn-primary:hover { filter: brightness(1.06); }
+.btn-ghost { background: transparent; color: var(--ink-soft); }
+.btn-ghost:hover { background: var(--paper-sunk); color: var(--ink); }
+.btn-outline { background: var(--paper); border-color: var(--line); color: var(--ink); }
+.btn-outline:hover { border-color: var(--ink-faint); }
+.btn-lg { height: 46px; padding: 0 22px; font-size: 15.5px; }
+
+/* ── hero ────────────────────────────────────────────────────────────────── */
+main { display: block; }
+
+.hero {
+  max-width: 880px;
+  margin: 0 auto;
+  padding: 84px 32px 56px;
+  text-align: center;
+}
+
+.eyebrow {
+  display: inline-block;
+  margin: 0 0 18px;
+  padding: 4px 11px;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: var(--brand-soft);
+  color: var(--brand);
+  font-size: 12.5px;
+  font-weight: 600;
+  letter-spacing: .02em;
+}
+
+.hero-title {
+  margin: 0 0 18px;
+  font-size: 54px;
+  line-height: 1.06;
+  letter-spacing: -.035em;
+  font-weight: 680;
+}
+
+.hero-copy {
+  margin: 0 auto 30px;
+  max-width: 62ch;
+  color: var(--ink-soft);
+  font-size: 18.5px;
+  line-height: 1.62;
+}
+
+.hero-actions { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }
+.hero-note { margin: 18px 0 0; color: var(--ink-faint); font-size: 13.5px; }
+
+/* ── stats ───────────────────────────────────────────────────────────────── */
+.stats {
+  display: flex;
+  justify-content: center;
+  gap: 56px;
+  padding: 26px 32px 40px;
+  border-top: 1px solid var(--line);
+  border-bottom: 1px solid var(--line);
+  background: var(--paper-sunk);
+  flex-wrap: wrap;
+}
+
+.stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }
+.stat-value { font-size: 30px; font-weight: 660; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
+.stat-label { color: var(--ink-faint); font-size: 13px; }
+
+/* ── features ────────────────────────────────────────────────────────────── */
+.features { max-width: 1080px; margin: 0 auto; padding: 72px 32px; }
+
+.section-title {
+  margin: 0 0 28px;
+  font-size: 30px;
+  letter-spacing: -.025em;
+  font-weight: 640;
+  text-align: center;
+}
+
+.feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
+
+.card {
+  padding: 22px;
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  background: var(--paper);
+  box-shadow: var(--shadow-sm);
+}
+
+.card:hover { box-shadow: var(--shadow-md); }
+.card-icon { display: inline-flex; color: var(--brand); margin-bottom: 12px; }
+.card-title { margin: 0 0 6px; font-size: 17px; font-weight: 620; letter-spacing: -.01em; }
+.card-copy { margin: 0; color: var(--ink-soft); font-size: 14.5px; line-height: 1.6; }
+
+/* ── cta band ────────────────────────────────────────────────────────────── */
+.cta-band {
+  margin: 0 32px 72px;
+  padding: 54px 32px;
