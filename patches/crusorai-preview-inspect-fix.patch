new file mode 100644
index 00000000..88b915fe
--- /dev/null
+++ b/src/preview/endpoint.py
@@ -0,0 +1,141 @@
+"""Crusor Preview — the proxy handshake file (how the IDE finds a running preview server).
+
+The preview proxy listens on an ephemeral loopback port and guards every proxied path with a
+capability token, so the workbench cannot guess either one. It publishes them the way the rest of
+the runtime publishes machine state: a small JSON file under ``$CRUSORAI_HOME/preview`` (default
+``~/.crusorai/preview``), named by session.
+
+    { "session_id": "...", "origin": "http://127.0.0.1:8931", "token": "...",
+      "workspace": "/abs/path", "pid": 4711, "started_at": 1760000000.0 }
+
+Why a file and not a protocol frame: Bridge Protocol v2 is a *session* channel (prompts, tools,
+approvals), and the preview endpoint is machine state that must survive a renderer reload, a
+window move, or a bridge restart without any of them having to renegotiate. A file is also
+inspectable by a human with ``cat`` when the preview will not load — which is exactly when you
+need it. Writes are atomic (temp + ``os.replace``) so a reader never sees half a document, and
+the file is ``0600``: the token in it is the only thing between a stray browser tab and the
+workspace.
+
+The TypeScript side (``contrib/crusorai/browser/crusorAIPreviewService.ts``) reads this file; the
+CLI in :mod:`src.preview.server` writes it.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import time
+from pathlib import Path
+from typing import Any
+
+__all__ = [
+    "DEFAULT_MAX_AGE_SECONDS",
+    "clear_endpoint",
+    "endpoint_path",
+    "preview_home",
+    "prune_stale",
+    "read_endpoint",
+    "runtime_home",
+    "write_endpoint",
+]
+
+#: An endpoint older than this is treated as abandoned by ``prune_stale``. Long-lived IDE sessions
+#: are normal, so this is generous: the point is to stop dead files accumulating, not to expire a
+#: working proxy.
+DEFAULT_MAX_AGE_SECONDS = 12 * 60 * 60
+
+_SAFE_SESSION = re.compile(r"[^A-Za-z0-9._-]+")
+
+
+def runtime_home() -> Path:
+    """``$CRUSORAI_HOME`` or ``~/.crusorai`` — the same root the rest of the runtime uses."""
+    configured = os.environ.get("CRUSORAI_HOME", "").strip()
+    base = Path(configured).expanduser() if configured else Path.home() / ".crusorai"
+    return base
+
+
+def preview_home() -> Path:
+    return runtime_home() / "preview"
+
+
+def _safe(name: str, fallback: str = "default") -> str:
+    """A session id is attacker-adjacent input (it can come from a URL); never a path."""
+    cleaned = _SAFE_SESSION.sub("_", str(name or "").strip()).strip("._")
+    return cleaned[:96] or fallback
+
+
+def endpoint_path(session_id: str) -> Path:
+    return preview_home() / f"{_safe(session_id)}.json"
+
+
+def write_endpoint(
+    session_id: str,
+    *,
+    origin: str,
+    token: str = "",
+    workspace: str | Path | None = None,
+    extra: dict[str, Any] | None = None,
+) -> Path:
+    """Publish the endpoint atomically. Returns the path written."""
+    directory = preview_home()
+    directory.mkdir(parents=True, exist_ok=True)
+    payload: dict[str, Any] = {
+        "session_id": str(session_id),
+        "origin": str(origin).rstrip("/"),
+        "token": str(token),
+        "workspace": str(workspace) if workspace is not None else "",
+        "pid": os.getpid(),
+        "started_at": time.time(),
+        "ui_path": "/crusor-preview/ui/",
+        "overlay_path": "/crusor-preview/overlay/crusor-preview-overlay.js",
+        "target_path": "/crusor-preview/target",
+        "health_path": "/crusor-preview/health",
+    }
+    if extra:
+        payload.update(extra)
+    path = endpoint_path(session_id)
+    temp = path.with_suffix(f".{os.getpid()}.tmp")
+    temp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    try:
+        os.chmod(temp, 0o600)
+    except OSError:  # pragma: no cover - Windows/odd filesystems
+        pass
+    os.replace(temp, path)
+    return path
+
+
+def read_endpoint(session_id: str) -> dict[str, Any] | None:
+    """Read a published endpoint, or ``None`` when it is absent or unreadable."""
+    path = endpoint_path(session_id)
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
+        return None
+    return payload if isinstance(payload, dict) and payload.get("origin") else None
+
+
+def clear_endpoint(session_id: str) -> bool:
+    """Remove a published endpoint. ``True`` when a file was actually removed."""
+    path = endpoint_path(session_id)
+    try:
+        path.unlink()
+        return True
+    except OSError:
+        return False
+
+
+def prune_stale(max_age_seconds: float = DEFAULT_MAX_AGE_SECONDS) -> list[Path]:
+    """Delete endpoint files older than ``max_age_seconds``; returns what was removed."""
+    cutoff = time.time() - max_age_seconds
+    removed: list[Path] = []
+    directory = preview_home()
+    if not directory.is_dir():
+        return removed
+    for path in sorted(directory.glob("*.json")):
+        try:
+            if path.stat().st_mtime < cutoff:
+                path.unlink()
+                removed.append(path)
+        except OSError:  # pragma: no cover - racing deletion
+            continue
+    return removed
diff --git a/src/preview/inject.py b/src/preview/inject.py
new file mode 100644
index 00000000..0fc80b17
--- /dev/null
+++ b/src/preview/inject.py
@@ -0,0 +1,178 @@
+"""Crusor Preview — HTML injection for the inspect-and-fix overlay.
+
+The preview window frames the UI the agent built. That document lives on an origin we do not
+control (a dev server on localhost, or a static file out of the workspace), so the overlay cannot
+be pushed into it from the parent frame — cross-origin documents are opaque. The honest way in is
+**server-side injection**: the Crusor preview proxy (:mod:`src.preview.server`) rewrites the HTML
+on the way through and adds the overlay script, after which the overlay and the preview window
+talk over ``postMessage`` (which needs no shared origin).
+
+Two things are injected, and nothing else:
+
+``<base href="{proxy-prefix}/">``
+    so every relative *and* root-relative subresource stays under the proxy prefix. The proxy
+    forwards any path under that prefix to the target origin, which means asset URLs, lazy chunks
+    and API calls all resolve without rewriting a single one of them. Skipped when the document
+    already declares a base.
+
+``<script src="…/crusor-preview-overlay.js">``
+    the overlay itself, dependency-free classic JS, mounted as soon as ``documentElement`` exists.
+
+Known limits (deliberate, not accidental):
+* a target page that sets its own CSP meta is loosened only as far as our script needs;
+* ``X-Frame-Options`` / CSP ``frame-ancestors`` are dropped from the *response headers* by the
+  proxy — the browser enforces framing on headers, not on HTML;
+* JS-level frame busters (``if (top !== self) top.location = …``) are not rewritten: patching
+  arbitrary page JS with a regex is how previews get silently corrupted;
+* HMR websockets are not proxied. The preview is for looking and clicking, not for hot-reload
+  fidelity — use Reload after the agent lands a fix.
+
+Pure stdlib, pure functions — pinned by ``src/tests/test_preview_inject.py``.
+"""
+from __future__ import annotations
+
+import re
+from html import escape
+from typing import Final
+
+__all__ = [
+    "INJECT_MARKER",
+    "has_overlay",
+    "inject_overlay",
+    "insert_base",
+    "relax_csp_meta",
+]
+
+#: Idempotency marker. Injection must survive being applied twice (a reload of an already
+#: proxied document, or a page that includes its own built copy).
+INJECT_MARKER: Final = "crusor-preview-overlay"
+
+# Requires a quoted href: a page whose COMMENT mentions "<base href>" (very common in
+# agent-written HTML, and in our own fixtures) must not be mistaken for one that has it.
+_BASE_TAG = re.compile(r"<base\s[^>]*href\s*=\s*[\"'][^\"']*[\"'][^>]*>", re.IGNORECASE)
+_HEAD_OPEN = re.compile(r"<head[^>]*>", re.IGNORECASE)
+_HTML_OPEN = re.compile(r"<html[^>]*>", re.IGNORECASE)
+_META_CSP = re.compile(
+    r'<meta[^>]+http-equiv\s*=\s*["\']?Content-Security-Policy["\']?[^>]*>',
+    re.IGNORECASE,
+)
+_FIRST_SCRIPT = re.compile(r"<script[\s>]", re.IGNORECASE)
+
+
+def has_overlay(html: str) -> bool:
+    """True when the overlay is already present (inject is idempotent)."""
+    return INJECT_MARKER in (html or "")
+
+
+def insert_base(html: str, href: str) -> str:
+    """Insert ``<base href>`` as the first child of ``<head>`` when the document has none.
+
+    Without it, a page served from the proxy origin resolves ``assets/app.js`` and
+    ``/api/data`` against the proxy instead of the target — the classic blank-preview failure.
+    """
+    if not html or not href:
+        return html
+    if _BASE_TAG.search(html):
+        return html
+    tag = f'<base href="{escape(href, quote=True)}" data-crusor-preview-base />'
+    match = _HEAD_OPEN.search(html)
+    if match:
+        return html[: match.end()] + tag + html[match.end():]
+    match = _HTML_OPEN.search(html)
+    if match:
+        return html[: match.end()] + f"<head>{tag}</head>" + html[match.end():]
+    return f"<head>{tag}</head>" + html
+
+
+def relax_csp_meta(html: str, *, script_src: str) -> str:
+    """Widen a target page's own CSP meta just enough for the injected overlay.
+
+    A dev-server page may ship ``script-src 'self'``; our script arrives from the proxy origin and
+    would be refused. We append the proxy origin (never ``'unsafe-inline'``) to ``script-src`` and
+    leave every other directive exactly as the project wrote it.
+    """
+    if not html or "<meta" not in html.lower():
+        return html
+
+    def patch(match: re.Match[str]) -> str:
+        tag = match.group(0)
+        content = re.search(r'content\s*=\s*"([^"]*)"|content\s*=\s*\'([^\']*)\'', tag, re.IGNORECASE)
+        if not content:
+            return tag
+        policy = content.group(1) or content.group(2) or ""
+        directives = [d.strip() for d in policy.split(";") if d.strip()]
+        names = [d.split()[0].lower() for d in directives]
+        if "script-src" in names:
+            directives = [
+                (d + " " + script_src) if d.split()[0].lower() == "script-src" and script_src not in d else d
+                for d in directives
+            ]
+        else:
+            directives.append(f"script-src {script_src}")
+        patched = "; ".join(directives)
+        return tag[: content.start(1) if content.group(1) is not None else content.start(2)] + patched + tag[
+            content.end(1) if content.group(1) is not None else content.end(2):
+        ]
+
+    return _META_CSP.sub(patch, html, count=1)
+
+
+def inject_overlay(
+    html: str,
+    *,
+    overlay_src: str,
+    base_href: str | None = None,
+    script_origin: str | None = None,
+    config: dict | None = None,
+) -> str:
+    """Inject the overlay (and, optionally, a ``<base>``) into an HTML document.
+
+    ``overlay_src``    URL of ``crusor-preview-overlay.js`` as the framed page sees it.
+    ``base_href``      proxy prefix to install as ``<base href>`` (``None`` keeps the document's).
+    ``script_origin``  origin to append to an existing CSP ``script-src`` (``None`` = no CSP edit).
+    ``config``         small JSON blob handed to the overlay before it boots (target label,
+                       session id). Never contains secrets: it is visible in the page.
+    """
+    if not html:
+        return html
+    if not has_overlay(html):
+        boot = ""
+        if config:
+            import json
+
+            boot = (
+                f'<script id="{INJECT_MARKER}-config" type="application/json">'
+                + json.dumps(config, ensure_ascii=False, separators=(",", ":")).replace("</", "<\\/")
+                + "</script>"
+            )
+        script = (
+            f'{boot}<script id="{INJECT_MARKER}" src="{escape(overlay_src, quote=True)}" '
+            'data-crusor-preview="1" defer></script>'
+        )
+        match = _HEAD_OPEN.search(html)
+        if match:
+            html = html[: match.end()] + script + html[match.end():]
+        else:
+            match = _FIRST_SCRIPT.search(html)
+            if match:
+                html = html[: match.start()] + script + html[match.start():]
+            else:
+                match = _HTML_OPEN.search(html)
+                html = (html[: match.end()] + script + html[match.end():]) if match else script + html
+    if base_href:
+        html = insert_base(html, base_href)
+    if script_origin:
+        html = relax_csp_meta(html, script_src=script_origin)
+    return html
+
+
+def is_html(content_type: str | None, body: bytes | None = None) -> bool:
+    """Should this response be treated as an injectable document?"""
+    ctype = (content_type or "").split(";")[0].strip().lower()
+    if ctype in {"text/html", "application/xhtml+xml"}:
+        return True
+    if ctype and ctype != "application/octet-stream":
+        return False
+    # No usable content type (some dev servers omit it for .html): sniff the first bytes.
+    head = (body or b"")[:512].lstrip().lower()
+    return head.startswith(b"<!doctype html") or head.startswith(b"<html")
diff --git a/src/preview/prompt.py b/src/preview/prompt.py
new file mode 100644
index 00000000..2410749c
--- /dev/null
+++ b/src/preview/prompt.py
@@ -0,0 +1,261 @@
+"""Crusor Preview — turn a batch of clicked-element fixes into one scoped agent turn.
+
+The Preview window collects fixes (element + instruction) while the user clicks around the UI
+the agent built. On **Review → Send to Crusor** the batch crosses the existing bridge as an
+ordinary ``prompt`` frame (protocol v2, no new method, no version bump): the value of this
+module is the *text* it produces, which is what makes the agent edit the right element instead
+of repainting the page.
+
+Design rules encoded here:
+
+* every fix names its element three ways — human label, CSS selector, and grep-able
+  fingerprints — because the agent's only reliable path from DOM to source is search;
+* the instruction is verbatim (the user's words are the requirement, never paraphrased);
+* the batch is explicitly *bounded*: change only these elements, touch nothing else;
+* the whole prompt is capped, oldest-fix-first truncation, so a 40-click session cannot blow
+  the turn budget.
+
+Pure stdlib, pure functions — pinned by ``src/tests/test_preview_prompt.py``.
+"""
+from __future__ import annotations
+
+from typing import Any, Iterable, Mapping, Sequence
+
+__all__ = [
+    "MAX_PROMPT_CHARS",
+    "PREVIEW_PROMPT_MARKER",
+    "build_preview_prompt",
+    "build_prompt_frame",
+    "describe_element",
+    "summarize_batch",
+]
+
+#: Hard ceiling for the generated prompt. The batch is truncated (newest fixes dropped, with a
+#: visible note) rather than allowed to grow without bound.
+MAX_PROMPT_CHARS = 12_000
+
+#: Stable marker so the renderer can recognise a preview-sourced turn and draw it as a card.
+PREVIEW_PROMPT_MARKER = "crusor-preview:fix-batch"
+
+#: Instructions the agent gets about scope. Kept as one block so it reads as a contract.
+_SCOPE_RULES = (
+    "Apply every fix below. Each one was created by clicking an element in the live preview of the "
+    "UI you built, so:\n"
+    "- change ONLY the named elements; leave the rest of the page alone;\n"
+    "- locate each element in the source with the fingerprints given (grep the classes, the text, "
+    "the data attributes) before editing — do not guess a file;\n"
+    "- keep the fix minimal and in the project's own style system (its tokens/variables/utility "
+    "classes), not inline overrides, unless the project already does that;\n"
+    "- if a fix is ambiguous or the element cannot be found, say so for that fix and continue with "
+    "the others;\n"
+    "- when done, list the files you changed."
+)
+
+
+def _text(value: Any, limit: int = 0) -> str:
+    text = str(value or "").replace("\r", " ").strip()
+    if limit and len(text) > limit:
+        text = text[: limit - 1].rstrip() + "…"
+    return text
+
+
+def _classes(element: Mapping[str, Any]) -> list[str]:
+    raw = element.get("classes")
+    if isinstance(raw, str):
+        return [c for c in raw.split() if c][:8]
+    if isinstance(raw, Iterable):
+        return [str(c) for c in raw if str(c)][:8]
+    return []
+
+
+def _fingerprint_line(element: Mapping[str, Any]) -> str:
+    """The grep-able identity of the element: what literally appears in the source file."""
+    fingerprint = element.get("fingerprint") if isinstance(element.get("fingerprint"), Mapping) else {}
+    parts: list[str] = []
+    classes = _classes(element)
+    if classes:
+        parts.append("classes=" + " ".join(classes))
+    text = _text(fingerprint.get("text") or element.get("text"), 90)
+    if text:
+        parts.append(f'text="{text}"')
+    attrs = fingerprint.get("attrs")
+    if isinstance(attrs, Iterable):
+        rendered = [
+            f'{a.get("name")}="{_text(a.get("value"), 60)}"'
+            for a in attrs
+            if isinstance(a, Mapping) and a.get("name")
+        ][:6]
+        if rendered:
+            parts.append("attrs=" + ", ".join(rendered))
+    if element.get("id"):
+        parts.append(f'id="{_text(element.get("id"), 60)}"')
+    return " · ".join(parts)
+
+
+def _source_hint(element: Mapping[str, Any]) -> str | None:
+    """Precise mapping, when the project stamps source positions into the DOM."""
+    fingerprint = element.get("fingerprint") if isinstance(element.get("fingerprint"), Mapping) else {}
+    source = fingerprint.get("source") or element.get("source")
+    if not isinstance(source, Mapping):
+        return None
+    file = _text(source.get("file"), 200)
+    if not file:
+        return None
+    line = source.get("line")
+    component = _text(source.get("component"), 80)
+    bits = [file]
+    if isinstance(line, int) and line > 0:
+        bits.append(f"line {line}")
+    if component:
+        bits.append(f"component {component}")
+    return " → ".join(bits)
+
+
+def _style_line(element: Mapping[str, Any]) -> str:
+    styles = element.get("styles")
+    if not isinstance(styles, Mapping):
+        return ""
+    # Only the properties a visual fix usually moves, in a stable order.
+    order = (
+        "background-color", "color", "border-radius", "border", "font-size", "font-weight",
+        "padding", "margin", "gap", "width", "height", "display", "text-align", "box-shadow",
+    )
+    rendered = [f"{key}: {styles[key]}" for key in order if key in styles and styles[key]]
+    rendered += [f"{k}: {v}" for k, v in styles.items() if k not in order and v][:4]
+    return "; ".join(rendered[:10])
+
+
+def describe_element(element: Mapping[str, Any]) -> str:
+    """Human label for one element: `<tag> "text"` or `<tag> .class`."""
+    tag = _text(element.get("tag"), 40) or "element"
+    text = _text(element.get("text"), 40)
+    classes = _classes(element)
+    if text:
+        return f'<{tag}> "{text}"'
+    if classes:
+        return f"<{tag}> .{classes[0]}"
+    return f"<{tag}>"
+
+
+def _fix_block(index: int, fix: Mapping[str, Any]) -> str:
+    element = fix.get("element") if isinstance(fix.get("element"), Mapping) else {}
+    label = _text(fix.get("label"), 120) or describe_element(element)
+    rect = element.get("rect") if isinstance(element.get("rect"), Mapping) else {}
+    viewport = element.get("viewport") if isinstance(element.get("viewport"), Mapping) else {}
+
+    lines = [
+        f"Fix {index} — {label}",
+        f"  instruction: {_text(fix.get('instruction'), 400) or '(empty)'}",
+    ]
+    if element.get("selector"):
+        lines.append(f"  selector: {_text(element.get('selector'), 220)}")
+    fingerprint = _fingerprint_line(element)
+    if fingerprint:
+        lines.append(f"  fingerprint: {fingerprint}")
+    source = _source_hint(element)
+    if source:
+        lines.append(f"  source: {source}")
+    if rect:
+        box = f"  box: {rect.get('width', 0)}×{rect.get('height', 0)} at ({rect.get('x', 0)},{rect.get('y', 0)})"
+        if viewport:
+            box += f" · viewport {viewport.get('width', 0)}×{viewport.get('height', 0)}"
+        lines.append(box)
+    styles = _style_line(element)
+    if styles:
+        lines.append(f"  styles: {styles}")
+    html = _text(element.get("outerHtml"), 420)
+    if html:
+        lines.append(f"  html: {html}")
+    return "\n".join(lines)
+
+
+def summarize_batch(batch: Mapping[str, Any]) -> str:
+    """One-line summary for the transcript card / toast."""
+    fixes = _fixes(batch)
+    count = len(fixes)
+    target = _text(batch.get("targetLabel") or batch.get("target"), 80)
+    label = f"{count} preview fix" + ("" if count == 1 else "es")
+    return f"{label} · {target}" if target else label
+
+
+def _fixes(batch: Mapping[str, Any]) -> Sequence[Mapping[str, Any]]:
+    raw = batch.get("fixes")
+    if not isinstance(raw, Sequence):
+        return ()
+    return [f for f in raw if isinstance(f, Mapping) and _text(f.get("instruction"))]
+
+
+def build_preview_prompt(batch: Mapping[str, Any]) -> str:
+    """Render a fix batch as the scoped prompt text sent to Crusor.
+
+    Truncates newest-first when the batch would exceed :data:`MAX_PROMPT_CHARS`, and says so in
+    the prompt itself — a silent drop would leave the user believing a fix was sent.
+    """
+    fixes = list(_fixes(batch))
+    if not fixes:
+        return ""
+
+    target = _text(batch.get("targetLabel") or batch.get("target"), 200) or "the previewed page"
+    viewport = _text(batch.get("viewport"), 40)
+    header = [
+        f"<!-- {PREVIEW_PROMPT_MARKER} count={len(fixes)} -->",
+        f"Crusor Preview — {len(fixes)} UI fix" + ("" if len(fixes) == 1 else "es") + f" from the live preview of {target}.",
+        "",
+        _SCOPE_RULES,
+    ]
+    if viewport and viewport != "responsive":
+        header.append(f"(Previewed at the {viewport} viewport preset.)")
+
+    blocks: list[str] = []
+    dropped = 0
+    for offset, fix in enumerate(fixes):
+        candidate = "\n\n".join(blocks + [_fix_block(offset + 1, fix)])
+        if len("\n".join(header)) + len(candidate) > MAX_PROMPT_CHARS:
+            dropped = len(fixes) - offset
+            break
+        blocks.append(_fix_block(offset + 1, fix))
+
+    parts = ["\n".join(header), "", "\n\n".join(blocks)]
+    if dropped:
+        parts.append(
+            f"\n({dropped} further fix" + ("" if dropped == 1 else "es") +
+            " were left out to stay inside the prompt budget — ask me to re-send them.)"
+        )
+    parts.append(
+        "\nAfter editing, re-render the preview so the change can be checked in place."
+    )
+    return "\n".join(parts).strip() + "\n"
+
+
+def build_prompt_frame(
+    batch: Mapping[str, Any],
+    *,
+    session_id: str,
+    mode: str = "agent",
+    reasoning_effort: str | None = None,
+) -> dict[str, Any]:
+    """Wrap the prompt in a bridge v2 ``prompt`` frame.
+
+    Raises ``ValueError`` for an empty batch so callers never fire a blank turn at the engine.
+    """
+    text = build_preview_prompt(batch)
+    if not text:
+        raise ValueError("preview fix batch is empty — nothing to send")
+    frame: dict[str, Any] = {
+        "type": "prompt",
+        "session_id": session_id,
+        "text": text,
+        "mode": mode,
+        "preview_batch": {
+            "marker": PREVIEW_PROMPT_MARKER,
+            "target": _text(batch.get("target"), 300),
+            "target_label": _text(batch.get("targetLabel"), 200),
+            "kind": _text(batch.get("kind"), 20),
+            "viewport": _text(batch.get("viewport"), 40),
+            "count": len(_fixes(batch)),
+            "created_at": _text(batch.get("createdAt"), 40),
+        },
+    }
+    if reasoning_effort:
+        frame["reasoning_effort"] = reasoning_effort
+    return frame
