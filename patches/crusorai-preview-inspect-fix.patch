+	--cp-approval: var(--crusorai-approval, var(--vscode-editorWarning-foreground, var(--vscode-charts-yellow, #fcd53a)));
+	--cp-failed: var(--crusorai-failed, var(--vscode-errorForeground, var(--vscode-charts-red, #fc533a)));
+
+	--cp-bg: var(--crusorai-preview-bg, var(--vscode-editor-background, #1f1f1f));
