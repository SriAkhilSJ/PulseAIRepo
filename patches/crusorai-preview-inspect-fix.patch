+	});
+
+	/* ------------------------------------------------------------------ *
+	 * Inbound messages
+	 * ------------------------------------------------------------------ */
+
+	window.addEventListener('message', function (event) {
+		var data = event && event.data;
+		if (!data || typeof data !== 'object') { return; }
+
+		if (data.source === 'crusor-preview-overlay') {
