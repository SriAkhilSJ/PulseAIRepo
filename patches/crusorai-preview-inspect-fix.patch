+	--cp-surface-strong: var(--crusorai-preview-surface-strong, var(--vscode-button-secondaryBackground, #2d2d2d));
+	--cp-stage: var(--crusorai-preview-stage, var(--vscode-panel-background, #141414));
+
+	--cp-text: var(--crusorai-preview-text, var(--vscode-foreground, #f1ece8));
+	--cp-text-weak: var(--crusorai-preview-text-weak, var(--vscode-descriptionForeground, #a0a0a0));
+	--cp-text-micro: var(--crusorai-preview-text-micro, var(--vscode-descriptionForeground, #707070));
+	--cp-border: var(--crusorai-preview-border, var(--vscode-widget-border, var(--vscode-panel-border, #3c3c3c)));
+	--cp-border-weak: var(--crusorai-preview-border-weak, var(--vscode-widget-border, #2d2d2d));
