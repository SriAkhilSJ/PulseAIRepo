diff --git a/preview-lab/lab_server.py b/preview-lab/lab_server.py
new file mode 100644
index 00000000..22ed5320
--- /dev/null
+++ b/preview-lab/lab_server.py
@@ -0,0 +1,243 @@
+"""Crusor Preview lab — the whole flow in one command, with no provider call.
+
+    python preview-lab/lab_server.py            # http://127.0.0.1:8931/lab/
+    python preview-lab/lab_server.py --port 9000 --host 0.0.0.0
+
+What runs here
+--------------
+* a throwaway HTTP server for ``demo-app/`` — the stand-in for "the dev server the agent started";
+* the REAL :class:`src.preview.server.PreviewServer` (proxy + injection) with lab routes mounted
+  through its ``extra_handler`` hook;
+* the REAL preview window chrome and the REAL injected overlay, served out of the desktop tree;
+* the REAL :mod:`src.preview.prompt` to build the scoped turn text;
+* a MOCK agent (:mod:`preview-lab.mock_agent`) that interprets the batch into a CSS override sheet
+  instead of editing a project, because there is no provider and no project in the lab.
+
+Open ``/lab/``, click **Open preview**, arm **Edit UI**, click elements, type fixes, **Review**,
+**Send to Crusor** — the batch lands in the Agent composer, the mock agent applies it, and the
+preview reloads with the change.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import sys
+import threading
+import urllib.parse
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from typing import Any
+
+LAB_ROOT = Path(__file__).resolve().parent
+REPO_ROOT = LAB_ROOT.parent
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from src.preview.prompt import build_preview_prompt, build_prompt_frame  # noqa: E402
+from src.preview.server import PreviewServer  # noqa: E402
+
+DEMO_APP = LAB_ROOT / "demo-app"
+RUNTIME = LAB_ROOT / ".runtime"
+SESSION_ID = "lab-session-preview"
+
+
+def _load_mock_agent():
+    """``preview-lab`` has a dash, so it is not an importable package — load the module by path."""
+    spec = importlib.util.spec_from_file_location("crusor_preview_mock_agent", LAB_ROOT / "mock_agent.py")
+    if spec is None or spec.loader is None:
+        raise RuntimeError("could not load preview-lab/mock_agent.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+MOCK_AGENT = _load_mock_agent()
+
+
+class DemoAppHandler(SimpleHTTPRequestHandler):
+    """Serves the fixture app. ``preview-overrides.css`` comes from the lab runtime directory.
+
+    That indirection is the point: the mock agent writes its edits OUTSIDE the committed fixture,
+    so the repo stays clean and **Reset demo** is just "delete the runtime sheet".
+    """
+
+    protocol_version = "HTTP/1.1"
+
+    def __init__(self, *args: Any, **kwargs: Any) -> None:
+        super().__init__(*args, directory=str(DEMO_APP), **kwargs)
+
+    def translate_path(self, path: str) -> str:
+        clean = urllib.parse.urlsplit(path).path
+        if clean.endswith("/" + MOCK_AGENT.OVERRIDE_STYLESHEET):
+            return str(RUNTIME / MOCK_AGENT.OVERRIDE_STYLESHEET)
+        return super().translate_path(path)
+
+    def send_head(self):  # noqa: N802 - stdlib signature
+        # A missing override sheet is normal (fresh lab) — serve empty CSS, not a 404 page.
+        if self.path.endswith("/" + MOCK_AGENT.OVERRIDE_STYLESHEET):
+            sheet = RUNTIME / MOCK_AGENT.OVERRIDE_STYLESHEET
+            body = sheet.read_bytes() if sheet.is_file() else b"/* no preview fixes applied yet */\n"
+            self.send_response(200)
+            self.send_header("Content-Type", "text/css; charset=utf-8")
+            self.send_header("Content-Length", str(len(body)))
+            self.send_header("Cache-Control", "no-store")
+            self.end_headers()
+            if self.command != "HEAD":
+                self.wfile.write(body)
+            return None
+        return super().send_head()
+
+    def end_headers(self) -> None:
+        # The preview reloads after every mock turn; a cached fixture would hide the change.
+        self.send_header("Cache-Control", "no-store")
+        super().end_headers()
+
+    def log_message(self, fmt: str, *args: Any) -> None:  # noqa: A003 - stdlib signature
+        pass
+
+
+def start_demo_app(port: int = 0) -> tuple[ThreadingHTTPServer, str]:
+    httpd = ThreadingHTTPServer(("127.0.0.1", port), DemoAppHandler)
+    httpd.daemon_threads = True
+    thread = threading.Thread(target=httpd.serve_forever, name="crusor-preview-demo-app", daemon=True)
+    thread.start()
+    origin = f"http://127.0.0.1:{httpd.server_address[1]}"
+    return httpd, origin
+
+
+def _read_json(handler) -> dict[str, Any]:
+    try:
+        length = int(handler.headers.get("Content-Length") or 0)
+        raw = handler.rfile.read(length) if length else b"{}"
+        payload = json.loads(raw.decode("utf-8") or "{}")
+    except (ValueError, json.JSONDecodeError) as exc:
+        return {"__error__": f"malformed JSON body: {exc}"}
+    return payload if isinstance(payload, dict) else {"__error__": "body must be an object"}
+
+
+def lab_routes(demo_app_origin: str):
+    """``extra_handler`` for PreviewServer: the lab's own endpoints, mounted before its routing."""
+
+    lab_assets = {"workbench.css": "text/css; charset=utf-8", "workbench.js": "application/javascript; charset=utf-8"}
+
+    def handle(method: str, path: str, handler) -> bool:
+        if path in {"/", "/lab", "/index.html"}:
+            handler.send_response(302)
+            handler.send_header("Location", "/lab/")
+            handler.send_header("Content-Length", "0")
+            handler.end_headers()
+            return True
+
+        if path == "/lab/":
+            body = (LAB_ROOT / "workbench.html").read_bytes()
+            handler._send(200, body, "text/html; charset=utf-8")  # noqa: SLF001 - lab harness, same family
+            return True
+
+        if path.startswith("/lab/") and method in {"GET", "HEAD"}:
+            name = path[len("/lab/"):]
+            if name in lab_assets:
+                body = (LAB_ROOT / name).read_bytes()
+                handler._send(200, body, lab_assets[name])  # noqa: SLF001
+                return True
+            # Not a lab asset: fall through to the endpoint routes below.
+
+        if path == "/lab/state" and method == "GET":
+            handler._json(200, {  # noqa: SLF001
+                # Empty origin == same-origin: the browser may be behind a reverse proxy, and only
+                # it knows the public host. Relative URLs are always right.
+                "proxyOrigin": "",
+                "demoAppOrigin": demo_app_origin,
+                "session": SESSION_ID,
+                "workspace": str(LAB_ROOT),
+                "mockAgent": True,
+                "targets": {
+                    "url": demo_app_origin + "/",
+                    "file": "demo-app/index.html",
+                },
+            })
+            return True
+
+        if path == "/lab/prompt" and method == "POST":
+            payload = _read_json(handler)
+            if "__error__" in payload:
+                handler._json(400, {"ok": False, "error": payload["__error__"]})  # noqa: SLF001
+                return True
+            batch = payload.get("batch") or {}
+            try:
+                text = build_preview_prompt(batch)
+                if not text:
+                    raise ValueError("empty fix batch")
+                frame = build_prompt_frame(
+                    batch,
+                    session_id=str(payload.get("session_id") or SESSION_ID),
+                    mode=str(payload.get("mode") or "agent"),
+                )
+            except ValueError as exc:
+                handler._json(400, {"ok": False, "error": str(exc)})  # noqa: SLF001
+                return True
+            handler._json(200, {"ok": True, "text": text, "frame": frame, "chars": len(text)})  # noqa: SLF001
+            return True
+
+        if path == "/lab/agent/apply" and method == "POST":
+            payload = _read_json(handler)
+            if "__error__" in payload:
+                handler._json(400, {"ok": False, "error": payload["__error__"]})  # noqa: SLF001
+                return True
+            receipt = MOCK_AGENT.apply_batch(payload.get("batch") or {}, RUNTIME)
+            handler._json(200, receipt)  # noqa: SLF001
+            return True
+
+        if path == "/lab/reset" and method == "POST":
+            handler._json(200, MOCK_AGENT.reset(RUNTIME))  # noqa: SLF001
+            return True
+
+        if path == "/lab/target/file" and method == "POST":
+            # The second supported target kind: a static HTML file the agent wrote, no dev server.
+            spec = handler.preview.register_file("demo-app/index.html", label="aurora-landing · workspace file")
+            handler._json(200, {  # noqa: SLF001
+                "ok": True, "token": spec.token, "kind": spec.kind, "label": spec.label,
+                "previewUrl": handler.preview.proxied_url(spec),
+            })
+            return True
+
+        return False
+
+    return handle
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="crusor-preview-lab", description=__doc__.splitlines()[0])
+    parser.add_argument("--host", default="0.0.0.0", help="bind address (0.0.0.0 so the lab is reachable)")
+    parser.add_argument("--port", type=int, default=8931)
+    args = parser.parse_args(argv)
+
+    RUNTIME.mkdir(parents=True, exist_ok=True)
+    demo_httpd, demo_origin = start_demo_app()
+    server = PreviewServer(
+        LAB_ROOT,
+        host=args.host,
+        port=args.port,
+        extra_handler=lab_routes(demo_origin),
+    ).start()
+
+    print("Crusor Preview lab")
+    print(f"  workbench (open this) : {server.origin}/lab/")
+    print(f"  preview window UI     : {server.origin}/crusor-preview/ui/")
+    print(f"  demo app (target)     : {demo_origin}/")
+    print(f"  runtime overrides     : {RUNTIME / MOCK_AGENT.OVERRIDE_STYLESHEET}")
+    print("  mock agent            : preview-lab/mock_agent.py (rules, no provider call)")
+    try:
+        while True:
+            threading.Event().wait(0.5)
+    except KeyboardInterrupt:  # pragma: no cover - interactive
+        pass
+    finally:
+        server.stop()
+        demo_httpd.shutdown()
+        demo_httpd.server_close()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/preview-lab/mock_agent.py b/preview-lab/mock_agent.py
new file mode 100644
index 00000000..f3436dd9
--- /dev/null
+++ b/preview-lab/mock_agent.py
@@ -0,0 +1,224 @@
+"""Preview lab — MOCK agent turn.
+
+This is the demo double for the real Crusor turn. In the IDE, ``Send to Crusor`` posts a bridge v2
+``prompt`` frame built by :mod:`src.preview.prompt` and the engine edits real source files. Here,
+with no provider call and no repo to edit, the same batch is interpreted by rules and written to a
+CSS override sheet that the fixture page links — so the loop is *visible*: send → edit → preview
+reloads → the clicked element has changed.
+
+Everything upstream of this file is the real thing: the preview window chrome, the injected
+overlay, the proxy, the injection, and the prompt builder. Only the model is mocked.
+"""
+from __future__ import annotations
+
+import re
+import time
+from pathlib import Path
+from typing import Any, Iterable, Sequence
+
+__all__ = ["apply_batch", "interpret", "OVERRIDE_STYLESHEET", "reset"]
+
+OVERRIDE_STYLESHEET = "preview-overrides.css"
+
+#: Keyword -> declarations. Ordered: earlier rules win when several match, so "make it not rounded"
+#: is handled before "rounded" by the negation pass.
+_RULES: Sequence[tuple[tuple[str, ...], dict[str, str]]] = (
+    (("hide", "remove", "delete", "get rid"), {"display": "none"}),
+    (("uppercase", "all caps", "capital"), {"text-transform": "uppercase"}),
+    (("lowercase",), {"text-transform": "lowercase"}),
+    (("underline",), {"text-decoration": "underline"}),
+    (("pill", "fully rounded", "fully round"), {"border-radius": "999px"}),
+    (("rounded", "round the corners", "round corners", "softer corners"), {"border-radius": "14px"}),
+    (("square corners", "sharp corners", "not rounded"), {"border-radius": "2px"}),
+    (("bolder", "bold", "heavier", "stronger"), {"font-weight": "700"}),
+    (("thinner", "lighter font", "not bold"), {"font-weight": "400"}),
+    (("bigger", "larger", "increase size", "scale up", "more prominent"), {"font-size": "1.25em"}),
+    (("smaller", "little smaller", "reduce size", "scale down", "subtler"), {"font-size": ".85em"}),
+    (("wider", "full width", "stretch"), {"width": "100%"}),
+    (("taller", "more height"), {"min-height": "56px"}),
+    (("center", "centre", "middle"), {"text-align": "center", "margin-left": "auto", "margin-right": "auto"}),
+    (("align left", "left align"), {"text-align": "left"}),
+    (("align right", "right align"), {"text-align": "right"}),
+    (("more spacing", "more padding", "roomier", "breathe", "airy"), {"padding": "1.5em 1.75em"}),
+    (("less spacing", "tighter", "compact"), {"padding": ".45em .7em"}),
+    (("more gap", "spread out", "space between"), {"gap": "24px"}),
+    (("shadow", "elevate", "lift", "depth"), {"box-shadow": "0 14px 34px -12px rgba(16,20,28,.42)"}),
+    (("no shadow", "flat", "remove shadow"), {"box-shadow": "none"}),
+    (("border", "outline it", "add a border"), {"border": "1px solid currentColor"}),
+    (("italic",), {"font-style": "italic"}),
+    (("mono", "monospace", "code font"), {"font-family": "ui-monospace, SFMono-Regular, Menlo, monospace"}),
+)
+
+_COLORS: dict[str, tuple[str, str]] = {
+    # name -> (background, foreground)
+    "blue": ("#2563eb", "#ffffff"),
+    "indigo": ("#4f46e5", "#ffffff"),
+    "purple": ("#7c3aed", "#ffffff"),
+    "violet": ("#8b5cf6", "#ffffff"),
+    "pink": ("#db2777", "#ffffff"),
+    "red": ("#dc2626", "#ffffff"),
+    "orange": ("#ea7317", "#1a1206"),
+    "amber": ("#f5b301", "#241c00"),
+    "yellow": ("#facc15", "#241c00"),
+    "green": ("#16a34a", "#ffffff"),
+    "teal": ("#0d9488", "#ffffff"),
+    "cyan": ("#0891b2", "#ffffff"),
+    "black": ("#14161a", "#ffffff"),
+    "white": ("#ffffff", "#14161a"),
+    "grey": ("#e4e7ec", "#14161a"),
+    "gray": ("#e4e7ec", "#14161a"),
+}
+
+_NEGATIONS = ("not ", "no ", "don't ", "dont ", "without ", "remove ", "never ")
+
+
+def _split_clauses(instruction: str) -> list[str]:
+    return [part.strip() for part in re.split(r"[,;]|\band\b|\balso\b|\bthen\b", instruction.lower()) if part.strip()]
+
+
+def interpret(instruction: str) -> tuple[dict[str, str], list[str]]:
+    """Map one natural-language fix to CSS declarations.
+
+    Returns ``(declarations, matched_rules)``. An empty ``declarations`` means the mock could not
+    read the instruction — the lab reports that honestly instead of silently doing nothing.
+    """
+    declarations: dict[str, str] = {}
+    matched: list[str] = []
+
+    for clause in _split_clauses(instruction):
+        negated = any(clause.startswith(neg) or f" {neg}" in clause for neg in _NEGATIONS)
+
+        # Color is its own axis: "make it blue", "blue background", "text in blue".
+        for name, (background, foreground) in _COLORS.items():
+            if not re.search(rf"\b{name}\b", clause):
+                continue
+            if negated:
+                declarations.pop("background-color", None)
+                declarations.pop("color", None)
+                matched.append(f"not-{name}")
+                break
+            if "text" in clause or "font" in clause or "label" in clause or "type" in clause:
+                declarations["color"] = background
+                matched.append(f"color:{name}")
+            else:
+                declarations["background-color"] = background
+                declarations["color"] = foreground
+                matched.append(f"background:{name}")
+            break
+
+        for keywords, styles in _RULES:
+            if not any(keyword in clause for keyword in keywords):
+                continue
+            if negated and keywords[0] not in ("hide", "remove", "delete", "get rid"):
+                matched.append("not-" + keywords[0])
+                for key in styles:
+                    declarations.pop(key, None)
+                break
+            declarations.update(styles)
+            matched.append(keywords[0])
+            break
+
+    return declarations, matched
+
+
+def _selector_for(element: dict[str, Any]) -> str:
+    selector = str(element.get("selector") or "").strip()
+    if not selector:
+        tag = str(element.get("tag") or "body")
+        selector = tag
+    # A comma-free, single-element selector keeps the override sheet readable and reversible.
+    return selector.split(",")[0].strip()
+
+
+def _render(fixes: Iterable[dict[str, Any]]) -> tuple[str, list[dict[str, Any]]]:
+    blocks: list[str] = []
+    results: list[dict[str, Any]] = []
+
+    for index, fix in enumerate(fixes, start=1):
+        element = fix.get("element") if isinstance(fix.get("element"), dict) else {}
+        instruction = str(fix.get("instruction") or "").strip()
+        selector = _selector_for(element)
+        declarations, matched = interpret(instruction)
+        label = str(fix.get("label") or element.get("tag") or "element")
+
+        if not declarations:
+            results.append({
+                "order": index, "label": label, "selector": selector, "instruction": instruction,
+                "status": "unresolved", "detail": "the mock agent could not read this instruction",
+                "matched": matched,
+            })
+            continue
+
+        source = element.get("fingerprint", {}).get("source") if isinstance(element.get("fingerprint"), dict) else None
+        source_note = ""
+        if isinstance(source, dict) and source.get("file"):
+            line = source.get("line")
+            source_note = f"{source['file']}" + (f":{line}" if line else "")
+        body = "\n".join(f"  {key}: {value} !important;" for key, value in declarations.items())
+        blocks.append(
+            f"/* fix {index} · {label}\n"
+            f"   instruction: {instruction}\n"
+            f"   located via: {source_note or 'fingerprint (classes/text/attrs)'} */\n"
+            f"{selector} {{\n{body}\n}}"
+        )
+        results.append({
+            "order": index, "label": label, "selector": selector, "instruction": instruction,
+            "status": "applied", "detail": ", ".join(f"{k}: {v}" for k, v in declarations.items()),
+            "matched": matched, "source": source_note or None,
+        })
+
+    header = (
+        "/* Crusor Preview — lab override sheet, written by the MOCK agent.\n"
+        " * In the IDE the agent edits the project's own source; here the edits land in this\n"
+        " * generated sheet so the loop is visible without a provider call. Reset clears it. */\n"
+    )
+    return header + "\n\n".join(blocks) + ("\n" if blocks else ""), results
+
+
+def _strip_header(css: str) -> str:
+    """Drop the leading comment block so repeated passes don't stack headers."""
+    marker = "*/"
+    index = css.find(marker)
+    return css[index + len(marker):].strip() if index != -1 else css.strip()
+
+
+def apply_batch(batch: dict[str, Any], runtime_dir: Path) -> dict[str, Any]:
+    """Interpret a reviewed batch and write the override sheet. Returns an agent-shaped receipt."""
+    fixes = [f for f in (batch.get("fixes") or []) if isinstance(f, dict)]
+    css, results = _render(fixes)
+    runtime_dir.mkdir(parents=True, exist_ok=True)
+    sheet = runtime_dir / OVERRIDE_STYLESHEET
+    previous = sheet.read_text(encoding="utf-8") if sheet.is_file() else ""
+
+    # Accumulate: a second review pass must not silently revert the first.
+    if previous.strip():
+        blocks = _strip_header(css)
+        merged = previous.rstrip() + ("\n\n" + blocks + "\n" if blocks else "\n")
+    else:
+        merged = css
+    sheet.write_text(merged, encoding="utf-8")
+
+    applied = [r for r in results if r["status"] == "applied"]
+    unresolved = [r for r in results if r["status"] != "applied"]
+    return {
+        "ok": bool(applied),
+        "sheet": OVERRIDE_STYLESHEET,
+        "files_changed": [f"preview-lab/.runtime/{OVERRIDE_STYLESHEET}"] if applied else [],
+        "applied": applied,
+        "unresolved": unresolved,
+        "summary": (
+            f"{len(applied)} of {len(results)} fix" + ("" if len(results) == 1 else "es") + " applied"
+            + (f", {len(unresolved)} unresolved" if unresolved else "")
+        ),
+        "selectors": [r["selector"] for r in applied],
+        "bytes_before": len(previous),
+        "bytes_after": len(sheet.read_text(encoding="utf-8")),
+        "at": time.time(),
+    }
+
+
+def reset(runtime_dir: Path) -> dict[str, Any]:
+    sheet = runtime_dir / OVERRIDE_STYLESHEET
+    if sheet.is_file():
+        sheet.unlink()
+    return {"ok": True, "cleared": OVERRIDE_STYLESHEET}
