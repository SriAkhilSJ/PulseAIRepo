+	align-items: center;
+	justify-content: center;
+	width: 20px;
+	height: 20px;
+	border-radius: 50%;
+	background: var(--cp-accent);
+	color: var(--cp-on-accent);
+	font: 600 var(--cp-text-body)/20px var(--cp-font-ui);
+	font-variant-numeric: tabular-nums;
+}
+
+.cpw-fix-main { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
+
+.cpw-fix-el {
+	display: inline-flex;
+	align-items: center;
+	gap: 5px;
+	color: var(--cp-accent);
+	font: 400 var(--cp-text-meta)/1.6 var(--cp-font-mono);
+}
+
+.cpw-fix-el svg { width: 12px; height: 12px; }
+
+.cpw-fix-el span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.cpw-fix-input {
+	display: block;
+	width: 100%;
+	min-height: 44px;
+	padding: 6px 7px;
+	background: var(--cp-surface-raised);
+	border: 1px solid var(--cp-border-weak);
+	border-radius: var(--cp-radius-sm);
+	color: var(--cp-text);
+	font: 400 var(--cp-text-copy)/1.5 var(--cp-font-ui);
+	outline: none;
+	resize: vertical;
+}
+
+.cpw-fix-input:focus { border-color: var(--cp-accent); }
+
+.cpw-fix-meta {
+	color: var(--cp-text-micro);
+	font: 400 var(--cp-text-meta)/1.5 var(--cp-font-mono);
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.cpw-fix-drop {
+	display: flex;
+	align-items: flex-start;
+	justify-content: center;
+	width: 22px;
+	height: 22px;
+	padding: 0;
+	background: transparent;
+	border: 1px solid transparent;
+	border-radius: var(--cp-radius-sm);
+	color: var(--cp-text-micro);
+	cursor: pointer;
+}
+
+.cpw-fix-drop svg { width: 13px; height: 13px; }
+.cpw-fix-drop:hover { color: var(--cp-failed); border-color: color-mix(in srgb, var(--cp-failed) 40%, transparent); }
+
+.cpw-sheet-empty { padding: 26px 12px; text-align: center; color: var(--cp-text-weak); font-size: var(--cp-text-copy); }
+
+.cpw-sheet-foot {
+	display: flex;
+	align-items: center;
+	gap: 8px;
+	padding: 10px 12px;
+	background: var(--cp-surface);
+	border-top: 1px solid var(--cp-border-weak);
+}
+
+.cpw-sheet-note { color: var(--cp-text-micro); font-size: var(--cp-text-meta); font-variant-numeric: tabular-nums; }
+
+/* ── toast ─────────────────────────────────────────────────────────────────────────────── */
+.cpw-toast {
+	position: fixed;
+	left: 50%;
+	bottom: 54px;
+	z-index: 60;
+	transform: translate(-50%, 8px);
+	display: flex;
+	align-items: center;
+	gap: 7px;
+	max-width: min(520px, calc(100% - 32px));
+	padding: 7px 12px;
+	background: var(--cp-surface-raised);
+	border: 1px solid var(--cp-border);
+	border-left: 2px solid var(--cp-verified);
+	border-radius: var(--cp-radius);
+	box-shadow: 0 12px 32px rgba(0, 0, 0, .45);
+	color: var(--cp-text);
+	font-size: var(--cp-text-body-lg);
+	opacity: 0;
+	pointer-events: none;
+	transition: opacity .16s ease, transform .16s ease;
+}
+
+.cpw-toast svg { width: 13px; height: 13px; color: var(--cp-verified); flex: 0 0 auto; }
+.cpw-toast.is-on { opacity: 1; transform: translate(-50%, 0); }
+.cpw-toast[data-tone="accent"] { border-left-color: var(--cp-accent); }
+.cpw-toast[data-tone="accent"] svg { color: var(--cp-accent); }
+.cpw-toast[data-tone="failed"] { border-left-color: var(--cp-failed); }
+.cpw-toast[data-tone="failed"] svg { color: var(--cp-failed); }
+
+@media (max-width: 720px) {
+	.cpw-viewports { display: none; }
+	.cpw-target { display: none; }
+}
