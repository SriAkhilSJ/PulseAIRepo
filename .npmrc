# Override the machine-global `bin-links=false` (C:\Users\Administrator\.npmrc).
# That setting prevented npm from creating .bin shims, which broke `npx` on Windows
# (every npx'd package failed with "not recognized as an internal or external command").
# Project-level config wins over user-level config, so this restores normal npx
# behavior for anything under this repo without touching the global file.
bin-links=true
